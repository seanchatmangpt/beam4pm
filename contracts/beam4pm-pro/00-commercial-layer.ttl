@prefix pro: <https://beam4pm.dev/pro/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pro:Beam4PMPro a pro:CommercialLayer ;
  dct:title "beam4pm_pro commercial layer" ;
  dct:description "Provider-neutral enterprise control plane layered on beam4pm without changing open substrate semantics." ;
  pro:substrate "seanchatmangpt/beam4pm" ;
  pro:authorityModel "SELECT != CONSTRUCT != DO" ;
  pro:customerTelemetryExportRequired false ;
  pro:generatedSourceDirectEditAllowed false ;
  pro:commercialStateReceipted true ;
  pro:runtimeIdentitySeparateFromContractIdentity true ;
  pro:standing "PARTIAL_ALIVE" ;
  prov:wasDerivedFrom <https://github.com/seanchatmangpt/beam4pm/blob/main/docs/jira/v26.8.29/04-cloud-marketplace-revops.md> .

pro:CapabilityContract a pro:ContractKind .
pro:CommercialControl a pro:ContractKind .
pro:acceptanceCrown a pro:ContractProperty .
pro:requiredEvidence a pro:ContractProperty .
pro:refusalCode a pro:ContractProperty .
pro:authorityCeiling a pro:ContractProperty .