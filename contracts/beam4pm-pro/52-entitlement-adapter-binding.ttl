@prefix pro: <https://beam4pm.dev/pro/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

pro:EntitlementAdapterBinding a pro:CapabilityContract ;
 dct:identifier "WS2-REV-053" ; dct:title "Marketplace entitlement adapter binding" ;
 pro:requiredEvidence "provider listing identity, agreement identity, event identity and event kind map deterministically into the local entitlement_event lifecycle with provider identity and deduplication identity preserved" ;
 pro:acceptanceCrown "duplicate provider events replay to the same local identity; unsupported event kinds refuse; normalization manufactures entitlement intent only and never grants or revokes commercial access by ambient authority" ;
 pro:adapterManufacturesIntentOnly true ; pro:providerIdentityPreserved true ;
 pro:authorityCeiling "SELECT|CONSTRUCT" ;
 pro:refusalCode "REFUSED[ENTITLEMENT_ADAPTER_EVENT_UNADMITTED]" ;
 prov:wasDerivedFrom <https://github.com/seanchatmangpt/beam4pm/blob/main/docs/jira/v26.8.29/04-cloud-marketplace-revops.md> .
