@prefix pro: <https://beam4pm.dev/pro/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

pro:PrivateOfferTemplate a pro:CapabilityContract ;
 dct:identifier "WS2-REV-054" ; dct:title "Versioned private-offer template" ;
 pro:requiredEvidence "an immutable template version declares allowed commercial variables, required approval evidence, supported packaging modes, provider target and compatibility bounds before an account-specific private_offer may be constructed" ;
 pro:acceptanceCrown "template replay is deterministic; missing variables or approval evidence refuse; rendering a template produces a draft offer artifact and never submits or binds price, term or marketplace consequence" ;
 pro:templateImmutableAfterRelease true ; pro:autoBindingOfferAllowed false ;
 pro:authorityCeiling "CONSTRUCT" ;
 pro:refusalCode "REFUSED[PRIVATE_OFFER_TEMPLATE_INCOMPLETE]" ;
 prov:wasDerivedFrom <https://github.com/seanchatmangpt/beam4pm/blob/main/docs/jira/v26.8.29/04-cloud-marketplace-revops.md> .
