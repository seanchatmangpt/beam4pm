@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# SHACL shapes paired with shacl_violation.ttl and shacl_conforms.ttl.

ex:PersonShape a sh:NodeShape ;
    sh:targetClass ex:Person ;
    sh:property [
        sh:path ex:name ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
