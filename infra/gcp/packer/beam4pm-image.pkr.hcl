packer {
  required_version = ">= 1.9.0"

  required_plugins {
    googlecompute = {
      version = ">= 1.1.1"
      source  = "github.com/hashicorp/googlecompute"
    }
  }
}

locals {
  build_ts   = formatdate("YYYYMMDDhhmmss", timestamp())
  image_name = "${var.image_name}-${local.build_ts}"
}

source "googlecompute" "beam4pm" {
  project_id              = var.project_id
  zone                    = var.zone
  machine_type            = var.machine_type
  source_image_family     = var.source_image_family
  source_image_project_id = [var.source_image_project]

  disk_size = var.disk_size_gb
  disk_type = "pd-balanced"

  image_name        = local.image_name
  image_family      = var.image_family
  image_description = "beam4pm_pro VM image: Debian 12 + Docker + pre-pulled beam4pm container under systemd"

  image_labels = {
    managed_by = "ggen"
    product    = "beam4pm-pro"
  }

  ssh_username = var.ssh_username

  tags = [
    "packer-build",
    "beam4pm-pro",
    "packer-builder",
  ]
}

build {
  name    = "beam4pm-pro-gce-image"
  sources = ["source.googlecompute.beam4pm"]

  # systemd unit for the pre-pulled product container. ${var.container_image}
  # is resolved by Packer at build time, so the unit carries the exact ref
  # the image was baked with.
  provisioner "file" {
    destination = "/tmp/beam4pm.service"
    content     = <<-EOT
      [Unit]
      Description=beam4pm_pro BEAM process-mining service (containerized)
      After=network-online.target docker.service
      Requires=docker.service
      Wants=network-online.target

      [Service]
      Restart=always
      RestartSec=10
      TimeoutStartSec=300
      ExecStartPre=-/usr/bin/docker rm -f beam4pm
      ExecStart=/usr/bin/docker run --rm --name beam4pm -p 8080:8080 ${var.container_image}
      ExecStop=/usr/bin/docker stop beam4pm

      [Install]
      WantedBy=multi-user.target
    EOT
  }

  provisioner "file" {
    destination = "/tmp/beam4pm-provision.sh"
    content     = <<-EOT
      #!/usr/bin/env bash
      set -euo pipefail

      echo "=== beam4pm_pro image provisioning ==="

      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y --no-install-recommends docker.io ca-certificates curl
      systemctl enable --now docker

      # Pre-pull the product container so first boot needs no registry
      # round-trip (the image ref is public on GHCR; no credentials baked).
      docker pull ${var.container_image}

      install -m 0644 /tmp/beam4pm.service /etc/systemd/system/beam4pm.service
      systemctl daemon-reload
      systemctl enable beam4pm.service

      # Inspectable image provenance facts (no secrets).
      {
        echo "image_name=${local.image_name}"
        echo "image_family=${var.image_family}"
        echo "container_image=${var.container_image}"
        echo "service_port=8080"
        echo "built_ts=${local.build_ts}"
      } > /etc/beam4pm-image-facts

      echo "=== beam4pm_pro image provisioning complete ==="
    EOT
  }

  provisioner "shell" {
    inline = [
      "chmod +x /tmp/beam4pm-provision.sh",
      "sudo bash /tmp/beam4pm-provision.sh",
    ]
  }

  provisioner "shell" {
    inline = [
      "sudo apt-get clean",
      "sudo rm -f /tmp/beam4pm-provision.sh /tmp/beam4pm.service",
    ]
  }
}
