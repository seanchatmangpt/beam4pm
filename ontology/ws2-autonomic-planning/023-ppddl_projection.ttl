@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-023 — ppddl_projection
b4p:ppddl_projection_rt a bpm:RecordType ;
    bpm:recordName "ppddl_projection" ;
    bpm:recordDoc "Binds a plan candidate to an exact PPDDL problem/domain projection." ;
    bpm:hasField b4p:ppddl_projection_plan_id_f,
                 b4p:ppddl_projection_domain_hash_f,
                 b4p:ppddl_projection_problem_hash_f .

b4p:ppddl_projection_plan_id_f a bpm:Field ;
    bpm:fieldName "plan_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required plan_id for this bounded planner contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:ppddl_projection_domain_hash_f a bpm:Field ;
    bpm:fieldName "domain_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required domain_hash for deterministic planner evaluation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:ppddl_projection_problem_hash_f a bpm:Field ;
    bpm:fieldName "problem_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required problem_hash preserving evidence and falsifiability." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
