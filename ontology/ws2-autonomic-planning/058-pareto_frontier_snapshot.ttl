@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-058 — pareto_frontier_snapshot
b4p:pareto_frontier_snapshot_rt a bpm:RecordType ;
    bpm:recordName "pareto_frontier_snapshot" ;
    bpm:recordDoc "Persists the nondominated option frontier before any irreversible selection." ;
    bpm:hasField b4p:pareto_frontier_snapshot_episode_id_f,
                 b4p:pareto_frontier_snapshot_frontier_digest_f,
                 b4p:pareto_frontier_snapshot_candidate_count_f .

b4p:pareto_frontier_snapshot_episode_id_f a bpm:Field ;
    bpm:fieldName "episode_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Planning episode owning this frontier." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:pareto_frontier_snapshot_frontier_digest_f a bpm:Field ;
    bpm:fieldName "frontier_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the complete nondominated option set." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:pareto_frontier_snapshot_candidate_count_f a bpm:Field ;
    bpm:fieldName "candidate_count" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact number of options preserved on the frontier." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
