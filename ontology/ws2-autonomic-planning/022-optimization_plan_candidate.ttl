@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-022 — optimization_plan_candidate
b4p:optimization_plan_candidate_rt a bpm:RecordType ;
    bpm:recordName "optimization_plan_candidate" ;
    bpm:recordDoc "Represents an optimization-derived plan with objective and solver receipt." ;
    bpm:hasField b4p:optimization_plan_candidate_plan_id_f,
                 b4p:optimization_plan_candidate_objective_id_f,
                 b4p:optimization_plan_candidate_solver_receipt_hash_f .

b4p:optimization_plan_candidate_plan_id_f a bpm:Field ;
    bpm:fieldName "plan_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required plan_id for this bounded planner contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:optimization_plan_candidate_objective_id_f a bpm:Field ;
    bpm:fieldName "objective_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required objective_id for deterministic planner evaluation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:optimization_plan_candidate_solver_receipt_hash_f a bpm:Field ;
    bpm:fieldName "solver_receipt_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required solver_receipt_hash preserving evidence and falsifiability." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
