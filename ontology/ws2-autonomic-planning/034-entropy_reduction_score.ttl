@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-034 — entropy_reduction_score
b4p:entropy_reduction_score_rt a bpm:RecordType ;
    bpm:recordName "entropy_reduction_score" ;
    bpm:recordDoc "Measures expected uncertainty reduction from a bounded observation action." ;
    bpm:hasField b4p:entropy_reduction_score_action_id_f,
                 b4p:entropy_reduction_score_prior_entropy_f,
                 b4p:entropy_reduction_score_expected_posterior_entropy_f .

b4p:entropy_reduction_score_action_id_f a bpm:Field ;
    bpm:fieldName "action_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required action_id for this bounded planner contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:entropy_reduction_score_prior_entropy_f a bpm:Field ;
    bpm:fieldName "prior_entropy" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required prior_entropy for deterministic planner evaluation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:entropy_reduction_score_expected_posterior_entropy_f a bpm:Field ;
    bpm:fieldName "expected_posterior_entropy" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required expected_posterior_entropy preserving evidence and falsifiability." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
