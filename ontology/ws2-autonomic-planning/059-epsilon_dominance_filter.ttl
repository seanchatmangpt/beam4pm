@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-059 — epsilon_dominance_filter
b4p:epsilon_dominance_filter_rt a bpm:RecordType ;
    bpm:recordName "epsilon_dominance_filter" ;
    bpm:recordDoc "Filters near-equivalent options using a declared epsilon while retaining removal witnesses." ;
    bpm:hasField b4p:epsilon_dominance_filter_episode_id_f,
                 b4p:epsilon_dominance_filter_epsilon_vector_f,
                 b4p:epsilon_dominance_filter_filter_receipt_hash_f .

b4p:epsilon_dominance_filter_episode_id_f a bpm:Field ;
    bpm:fieldName "episode_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Planning episode being filtered." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:epsilon_dominance_filter_epsilon_vector_f a bpm:Field ;
    bpm:fieldName "epsilon_vector" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Per-objective epsilon values used for dominance." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:epsilon_dominance_filter_filter_receipt_hash_f a bpm:Field ;
    bpm:fieldName "filter_receipt_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Receipt binding removed candidates to dominance witnesses." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
