@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-069 — planner_reliability_score
b4p:planner_reliability_score_rt a bpm:RecordType ;
    bpm:recordName "planner_reliability_score" ;
    bpm:recordDoc "Maintains evidence-bounded reliability for each planner from verified historical outcomes." ;
    bpm:hasField b4p:planner_reliability_score_planner_id_f,
                 b4p:planner_reliability_score_sample_window_digest_f,
                 b4p:planner_reliability_score_reliability_score_f .

b4p:planner_reliability_score_planner_id_f a bpm:Field ;
    bpm:fieldName "planner_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact planner whose reliability is estimated." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:planner_reliability_score_sample_window_digest_f a bpm:Field ;
    bpm:fieldName "sample_window_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the admitted verification window." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:planner_reliability_score_reliability_score_f a bpm:Field ;
    bpm:fieldName "reliability_score" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Reliability score derived only from verified outcomes." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
