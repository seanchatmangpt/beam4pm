@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-045 — event_triggered_planning
b4p:event_triggered_planning_rt a bpm:RecordType ;
    bpm:recordName "event_triggered_planning" ;
    bpm:recordDoc "Creates a bounded planning episode from an admitted world event." ;
    bpm:hasField b4p:event_triggered_planning_event_id_f,
                 b4p:event_triggered_planning_world_state_hash_f,
                 b4p:event_triggered_planning_episode_id_f .

b4p:event_triggered_planning_event_id_f a bpm:Field ;
    bpm:fieldName "event_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required event_id for this bounded planner contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:event_triggered_planning_world_state_hash_f a bpm:Field ;
    bpm:fieldName "world_state_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required world_state_hash for deterministic planner evaluation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:event_triggered_planning_episode_id_f a bpm:Field ;
    bpm:fieldName "episode_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required episode_id preserving evidence and falsifiability." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
