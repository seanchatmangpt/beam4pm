@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-057 — lexicographic_value_policy
b4p:lexicographic_value_policy_rt a bpm:RecordType ;
    bpm:recordName "lexicographic_value_policy" ;
    bpm:recordDoc "Applies objective precedence only when an explicit lexicographic order is admitted." ;
    bpm:hasField b4p:lexicographic_value_policy_policy_id_f,
                 b4p:lexicographic_value_policy_precedence_vector_f,
                 b4p:lexicographic_value_policy_selection_evidence_hash_f .

b4p:lexicographic_value_policy_policy_id_f a bpm:Field ;
    bpm:fieldName "policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Identity of the admitted precedence policy." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:lexicographic_value_policy_precedence_vector_f a bpm:Field ;
    bpm:fieldName "precedence_vector" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Ordered objective precedence used by selection." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:lexicographic_value_policy_selection_evidence_hash_f a bpm:Field ;
    bpm:fieldName "selection_evidence_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Evidence digest proving the policy was applied exactly." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
