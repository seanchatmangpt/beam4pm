@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-096 — robust_selection
b4p:robust_selection_rt a bpm:RecordType ;
    bpm:recordName "robust_selection" ;
    bpm:recordDoc "Selects candidates that remain admissible across a declared scenario set without erasing scenario-specific evidence." ;
    bpm:hasField b4p:robust_selection_episode_id_f,
                 b4p:robust_selection_scenario_set_id_f,
                 b4p:robust_selection_frontier_digest_f .

b4p:robust_selection_episode_id_f a bpm:Field ;
    bpm:fieldName "episode_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Planning episode using robust selection." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:robust_selection_scenario_set_id_f a bpm:Field ;
    bpm:fieldName "scenario_set_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Scenario set against which candidates are tested." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:robust_selection_frontier_digest_f a bpm:Field ;
    bpm:fieldName "frontier_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of candidates surviving the robustness court." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
