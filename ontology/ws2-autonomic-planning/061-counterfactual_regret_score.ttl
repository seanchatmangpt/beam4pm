@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-061 — counterfactual_regret_score
b4p:counterfactual_regret_score_rt a bpm:RecordType ;
    bpm:recordName "counterfactual_regret_score" ;
    bpm:recordDoc "Scores the regret of choosing one lawful option against preserved counterfactual alternatives." ;
    bpm:hasField b4p:counterfactual_regret_score_candidate_id_f,
                 b4p:counterfactual_regret_score_comparison_frontier_digest_f,
                 b4p:counterfactual_regret_score_regret_score_f .

b4p:counterfactual_regret_score_candidate_id_f a bpm:Field ;
    bpm:fieldName "candidate_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Candidate being evaluated." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:counterfactual_regret_score_comparison_frontier_digest_f a bpm:Field ;
    bpm:fieldName "comparison_frontier_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the preserved comparison frontier." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:counterfactual_regret_score_regret_score_f a bpm:Field ;
    bpm:fieldName "regret_score" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Computed regret value under the admitted value model." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
