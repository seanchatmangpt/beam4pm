@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-040 — irreversibility_budget
b4p:irreversibility_budget_rt a bpm:RecordType ;
    bpm:recordName "irreversibility_budget" ;
    bpm:recordDoc "Limits irreversible commitments within one bounded planning episode." ;
    bpm:hasField b4p:irreversibility_budget_episode_id_f,
                 b4p:irreversibility_budget_budget_f,
                 b4p:irreversibility_budget_consumed_f .

b4p:irreversibility_budget_episode_id_f a bpm:Field ;
    bpm:fieldName "episode_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required episode_id for this bounded planner contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:irreversibility_budget_budget_f a bpm:Field ;
    bpm:fieldName "budget" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required budget for deterministic planner evaluation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:irreversibility_budget_consumed_f a bpm:Field ;
    bpm:fieldName "consumed" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required consumed preserving evidence and falsifiability." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
