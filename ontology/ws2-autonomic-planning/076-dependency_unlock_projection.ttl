@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-076 — dependency_unlock_projection
b4p:dependency_unlock_projection_rt a bpm:RecordType ;
    bpm:recordName "dependency_unlock_projection" ;
    bpm:recordDoc "Projects which blocked opportunities become reachable if a candidate action succeeds." ;
    bpm:hasField b4p:dependency_unlock_projection_candidate_id_f,
                 b4p:dependency_unlock_projection_unlock_set_digest_f,
                 b4p:dependency_unlock_projection_dependency_snapshot_digest_f .

b4p:dependency_unlock_projection_candidate_id_f a bpm:Field ;
    bpm:fieldName "candidate_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Candidate whose successful consequence is being projected." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:dependency_unlock_projection_unlock_set_digest_f a bpm:Field ;
    bpm:fieldName "unlock_set_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of opportunities unlocked by that consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:dependency_unlock_projection_dependency_snapshot_digest_f a bpm:Field ;
    bpm:fieldName "dependency_snapshot_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the dependency graph used for the projection." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
