@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-002 — caller_local_consumer
b4p:caller_local_consumer_rt a bpm:RecordType ;
    bpm:recordName "caller_local_consumer" ;
    bpm:recordDoc "Preserves each caller-local consumer as an independently planned exact subject." ;
    bpm:hasField b4p:caller_local_consumer_consumer_id_f,
                 b4p:caller_local_consumer_subject_sha_f,
                 b4p:caller_local_consumer_consumer_hash_f .

b4p:caller_local_consumer_consumer_id_f a bpm:Field ;
    bpm:fieldName "consumer_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required consumer_id for this bounded planner contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:caller_local_consumer_subject_sha_f a bpm:Field ;
    bpm:fieldName "subject_sha" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required subject_sha for deterministic planner evaluation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:caller_local_consumer_consumer_hash_f a bpm:Field ;
    bpm:fieldName "consumer_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required consumer_hash preserving evidence and falsifiability." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
