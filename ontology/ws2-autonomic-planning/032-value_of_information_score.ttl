@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-032 — value_of_information_score
b4p:value_of_information_score_rt a bpm:RecordType ;
    bpm:recordName "value_of_information_score" ;
    bpm:recordDoc "Scores the expected value of acquiring missing information before selection." ;
    bpm:hasField b4p:value_of_information_score_option_id_f,
                 b4p:value_of_information_score_observation_id_f,
                 b4p:value_of_information_score_score_f .

b4p:value_of_information_score_option_id_f a bpm:Field ;
    bpm:fieldName "option_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required option_id for this bounded planner contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:value_of_information_score_observation_id_f a bpm:Field ;
    bpm:fieldName "observation_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required observation_id for deterministic planner evaluation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:value_of_information_score_score_f a bpm:Field ;
    bpm:fieldName "score" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required score preserving evidence and falsifiability." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
