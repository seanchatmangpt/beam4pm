@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-075 — opportunity_graph_frontier
b4p:opportunity_graph_frontier_rt a bpm:RecordType ;
    bpm:recordName "opportunity_graph_frontier" ;
    bpm:recordDoc "Materializes the currently reachable opportunity graph boundary after constraints and dependency closure." ;
    bpm:hasField b4p:opportunity_graph_frontier_episode_id_f,
                 b4p:opportunity_graph_frontier_frontier_node_digest_f,
                 b4p:opportunity_graph_frontier_frontier_edge_digest_f .

b4p:opportunity_graph_frontier_episode_id_f a bpm:Field ;
    bpm:fieldName "episode_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Planning episode whose opportunities are exposed." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:opportunity_graph_frontier_frontier_node_digest_f a bpm:Field ;
    bpm:fieldName "frontier_node_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of currently reachable opportunity nodes." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:opportunity_graph_frontier_frontier_edge_digest_f a bpm:Field ;
    bpm:fieldName "frontier_edge_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of dependency and exclusion edges at the frontier." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
