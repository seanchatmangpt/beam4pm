@prefix bpm: <https://beam4pm.dev/ontology/process#> .
@prefix b4p: <https://beam4pm.dev/ontology/instance#> .

# WS2-PLAN-093 — execution_risk_score
b4p:execution_risk_score_rt a bpm:RecordType ;
    bpm:recordName "execution_risk_score" ;
    bpm:recordDoc "Separates expected consequence risk from planner confidence and value estimates." ;
    bpm:hasField b4p:execution_risk_score_candidate_id_f,
                 b4p:execution_risk_score_risk_factor_digest_f,
                 b4p:execution_risk_score_risk_score_f .

b4p:execution_risk_score_candidate_id_f a bpm:Field ;
    bpm:fieldName "candidate_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Candidate whose consequence risk is estimated." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:execution_risk_score_risk_factor_digest_f a bpm:Field ;
    bpm:fieldName "risk_factor_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of admitted risk factors and dependencies." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:execution_risk_score_risk_score_f a bpm:Field ;
    bpm:fieldName "risk_score" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Expected consequence-risk score used by selection." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
