@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-101 — meter_definition
bpm:meter_definition_rt a bpm:RecordType ;
    bpm:recordName "meter_definition" ;
    bpm:recordDoc "Immutable billable-meter definition." ;
    bpm:hasField bpm:meter_definition_meter_definition_id_f,
                 bpm:meter_definition_account_id_f,
                 bpm:meter_definition_meter_name_f,
                 bpm:meter_definition_evidence_digest_f,
                 bpm:meter_definition_effective_at_f .

bpm:meter_definition_meter_definition_id_f a bpm:Field ;
    bpm:fieldName "meter_definition_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this meter definition contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:meter_definition_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:meter_definition_meter_name_f a bpm:Field ;
    bpm:fieldName "meter_name" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable buyer-visible identity of the commercial meter." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:meter_definition_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:meter_definition_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
