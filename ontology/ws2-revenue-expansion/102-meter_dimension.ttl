@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-102 — meter_dimension
bpm:meter_dimension_rt a bpm:RecordType ;
    bpm:recordName "meter_dimension" ;
    bpm:recordDoc "Typed dimension attached to a commercial meter." ;
    bpm:hasField bpm:meter_dimension_meter_dimension_id_f,
                 bpm:meter_dimension_account_id_f,
                 bpm:meter_dimension_dimension_name_f,
                 bpm:meter_dimension_evidence_digest_f,
                 bpm:meter_dimension_effective_at_f .

bpm:meter_dimension_meter_dimension_id_f a bpm:Field ;
    bpm:fieldName "meter_dimension_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this meter dimension contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:meter_dimension_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:meter_dimension_dimension_name_f a bpm:Field ;
    bpm:fieldName "dimension_name" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable dimension identity used for pricing and reporting." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:meter_dimension_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:meter_dimension_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
