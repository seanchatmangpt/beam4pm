@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-104 — quota_burst_allowance
bpm:quota_burst_allowance_rt a bpm:RecordType ;
    bpm:recordName "quota_burst_allowance" ;
    bpm:recordDoc "Purchased temporary quota burst allowance." ;
    bpm:hasField bpm:quota_burst_allowance_quota_burst_allowance_id_f,
                 bpm:quota_burst_allowance_account_id_f,
                 bpm:quota_burst_allowance_burst_units_f,
                 bpm:quota_burst_allowance_evidence_digest_f,
                 bpm:quota_burst_allowance_effective_at_f .

bpm:quota_burst_allowance_quota_burst_allowance_id_f a bpm:Field ;
    bpm:fieldName "quota_burst_allowance_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this quota burst allowance contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:quota_burst_allowance_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:quota_burst_allowance_burst_units_f a bpm:Field ;
    bpm:fieldName "burst_units" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Additional units admitted above the contracted quota." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:quota_burst_allowance_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:quota_burst_allowance_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
