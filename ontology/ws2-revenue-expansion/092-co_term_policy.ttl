@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-092 — co_term_policy
bpm:co_term_policy_rt a bpm:RecordType ;
    bpm:recordName "co_term_policy" ;
    bpm:recordDoc "Co-termination policy for expansion purchases." ;
    bpm:hasField bpm:co_term_policy_co_term_policy_id_f,
                 bpm:co_term_policy_account_id_f,
                 bpm:co_term_policy_coterm_date_f,
                 bpm:co_term_policy_evidence_digest_f,
                 bpm:co_term_policy_effective_at_f .

bpm:co_term_policy_co_term_policy_id_f a bpm:Field ;
    bpm:fieldName "co_term_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this co term policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:co_term_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:co_term_policy_coterm_date_f a bpm:Field ;
    bpm:fieldName "coterm_date" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "Contract end instant to which the expansion is aligned." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:co_term_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:co_term_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
