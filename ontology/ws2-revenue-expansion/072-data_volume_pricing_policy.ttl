@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-072 — data_volume_pricing_policy
bpm:data_volume_pricing_policy_rt a bpm:RecordType ;
    bpm:recordName "data_volume_pricing_policy" ;
    bpm:recordDoc "Data-volume commercial packaging dimension." ;
    bpm:hasField bpm:data_volume_pricing_policy_data_volume_pricing_policy_id_f,
                 bpm:data_volume_pricing_policy_account_id_f,
                 bpm:data_volume_pricing_policy_unit_gb_price_f,
                 bpm:data_volume_pricing_policy_evidence_digest_f,
                 bpm:data_volume_pricing_policy_effective_at_f .

bpm:data_volume_pricing_policy_data_volume_pricing_policy_id_f a bpm:Field ;
    bpm:fieldName "data_volume_pricing_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this data volume pricing policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:data_volume_pricing_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:data_volume_pricing_policy_unit_gb_price_f a bpm:Field ;
    bpm:fieldName "unit_gb_price" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Admitted unit price per processed gigabyte." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:data_volume_pricing_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:data_volume_pricing_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
