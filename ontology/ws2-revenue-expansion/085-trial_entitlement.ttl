@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-085 — trial_entitlement
bpm:trial_entitlement_rt a bpm:RecordType ;
    bpm:recordName "trial_entitlement" ;
    bpm:recordDoc "Time-bounded enterprise trial entitlement." ;
    bpm:hasField bpm:trial_entitlement_trial_entitlement_id_f,
                 bpm:trial_entitlement_account_id_f,
                 bpm:trial_entitlement_trial_expires_at_f,
                 bpm:trial_entitlement_evidence_digest_f,
                 bpm:trial_entitlement_effective_at_f .

bpm:trial_entitlement_trial_entitlement_id_f a bpm:Field ;
    bpm:fieldName "trial_entitlement_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this trial entitlement contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:trial_entitlement_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:trial_entitlement_trial_expires_at_f a bpm:Field ;
    bpm:fieldName "trial_expires_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "Exact instant at which trial capability must be refused." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:trial_entitlement_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:trial_entitlement_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
