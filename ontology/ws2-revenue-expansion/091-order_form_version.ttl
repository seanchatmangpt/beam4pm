@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-091 — order_form_version
bpm:order_form_version_rt a bpm:RecordType ;
    bpm:recordName "order_form_version" ;
    bpm:recordDoc "Immutable commercial order-form version." ;
    bpm:hasField bpm:order_form_version_order_form_version_id_f,
                 bpm:order_form_version_account_id_f,
                 bpm:order_form_version_order_form_digest_f,
                 bpm:order_form_version_evidence_digest_f,
                 bpm:order_form_version_effective_at_f .

bpm:order_form_version_order_form_version_id_f a bpm:Field ;
    bpm:fieldName "order_form_version_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this order form version contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:order_form_version_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:order_form_version_order_form_digest_f a bpm:Field ;
    bpm:fieldName "order_form_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Content digest of the accepted order form." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:order_form_version_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:order_form_version_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
