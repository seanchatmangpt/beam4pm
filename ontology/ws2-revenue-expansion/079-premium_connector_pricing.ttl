@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-079 — premium_connector_pricing
bpm:premium_connector_pricing_rt a bpm:RecordType ;
    bpm:recordName "premium_connector_pricing" ;
    bpm:recordDoc "Paid integration-connector add-on." ;
    bpm:hasField bpm:premium_connector_pricing_premium_connector_pricing_id_f,
                 bpm:premium_connector_pricing_account_id_f,
                 bpm:premium_connector_pricing_connector_id_f,
                 bpm:premium_connector_pricing_evidence_digest_f,
                 bpm:premium_connector_pricing_effective_at_f .

bpm:premium_connector_pricing_premium_connector_pricing_id_f a bpm:Field ;
    bpm:fieldName "premium_connector_pricing_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this premium connector pricing contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:premium_connector_pricing_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:premium_connector_pricing_connector_id_f a bpm:Field ;
    bpm:fieldName "connector_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of the separately priced connector." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:premium_connector_pricing_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:premium_connector_pricing_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
