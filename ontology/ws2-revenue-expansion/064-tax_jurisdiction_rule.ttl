@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-064 — tax_jurisdiction_rule
bpm:tax_jurisdiction_rule_rt a bpm:RecordType ;
    bpm:recordName "tax_jurisdiction_rule" ;
    bpm:recordDoc "Tax jurisdiction routing for a contracting entity." ;
    bpm:hasField bpm:tax_jurisdiction_rule_tax_jurisdiction_rule_id_f,
                 bpm:tax_jurisdiction_rule_account_id_f,
                 bpm:tax_jurisdiction_rule_jurisdiction_code_f,
                 bpm:tax_jurisdiction_rule_evidence_digest_f,
                 bpm:tax_jurisdiction_rule_effective_at_f .

bpm:tax_jurisdiction_rule_tax_jurisdiction_rule_id_f a bpm:Field ;
    bpm:fieldName "tax_jurisdiction_rule_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this tax jurisdiction rule contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:tax_jurisdiction_rule_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:tax_jurisdiction_rule_jurisdiction_code_f a bpm:Field ;
    bpm:fieldName "jurisdiction_code" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Admitted tax jurisdiction code for invoice treatment." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:tax_jurisdiction_rule_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:tax_jurisdiction_rule_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
