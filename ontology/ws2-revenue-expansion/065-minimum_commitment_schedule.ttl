@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-065 — minimum_commitment_schedule
bpm:minimum_commitment_schedule_rt a bpm:RecordType ;
    bpm:recordName "minimum_commitment_schedule" ;
    bpm:recordDoc "Time-phased minimum-spend commitment." ;
    bpm:hasField bpm:minimum_commitment_schedule_minimum_commitment_schedule_id_f,
                 bpm:minimum_commitment_schedule_account_id_f,
                 bpm:minimum_commitment_schedule_committed_amount_f,
                 bpm:minimum_commitment_schedule_evidence_digest_f,
                 bpm:minimum_commitment_schedule_effective_at_f .

bpm:minimum_commitment_schedule_minimum_commitment_schedule_id_f a bpm:Field ;
    bpm:fieldName "minimum_commitment_schedule_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this minimum commitment schedule contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:minimum_commitment_schedule_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:minimum_commitment_schedule_committed_amount_f a bpm:Field ;
    bpm:fieldName "committed_amount" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Commercially admitted minimum amount for the schedule window." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:minimum_commitment_schedule_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:minimum_commitment_schedule_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
