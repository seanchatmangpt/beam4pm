@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-066 — spend_drawdown
bpm:spend_drawdown_rt a bpm:RecordType ;
    bpm:recordName "spend_drawdown" ;
    bpm:recordDoc "Observed consumption against committed spend." ;
    bpm:hasField bpm:spend_drawdown_spend_drawdown_id_f,
                 bpm:spend_drawdown_account_id_f,
                 bpm:spend_drawdown_consumed_amount_f,
                 bpm:spend_drawdown_evidence_digest_f,
                 bpm:spend_drawdown_effective_at_f .

bpm:spend_drawdown_spend_drawdown_id_f a bpm:Field ;
    bpm:fieldName "spend_drawdown_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this spend drawdown contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:spend_drawdown_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:spend_drawdown_consumed_amount_f a bpm:Field ;
    bpm:fieldName "consumed_amount" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Amount actually drawn from the committed-spend balance." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:spend_drawdown_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:spend_drawdown_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
