@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-086 — proof_of_value_package
bpm:proof_of_value_package_rt a bpm:RecordType ;
    bpm:recordName "proof_of_value_package" ;
    bpm:recordDoc "Paid proof-of-value package with measurable exit criterion." ;
    bpm:hasField bpm:proof_of_value_package_proof_of_value_package_id_f,
                 bpm:proof_of_value_package_account_id_f,
                 bpm:proof_of_value_package_success_metric_f,
                 bpm:proof_of_value_package_evidence_digest_f,
                 bpm:proof_of_value_package_effective_at_f .

bpm:proof_of_value_package_proof_of_value_package_id_f a bpm:Field ;
    bpm:fieldName "proof_of_value_package_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this proof of value package contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:proof_of_value_package_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:proof_of_value_package_success_metric_f a bpm:Field ;
    bpm:fieldName "success_metric" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Canonical metric that determines proof-of-value acceptance." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:proof_of_value_package_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:proof_of_value_package_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
