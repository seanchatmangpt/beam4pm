@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-082 — bundle_conflict
bpm:bundle_conflict_rt a bpm:RecordType ;
    bpm:recordName "bundle_conflict" ;
    bpm:recordDoc "Mutual exclusion between incompatible bundles." ;
    bpm:hasField bpm:bundle_conflict_bundle_conflict_id_f,
                 bpm:bundle_conflict_account_id_f,
                 bpm:bundle_conflict_conflicting_bundle_id_f,
                 bpm:bundle_conflict_evidence_digest_f,
                 bpm:bundle_conflict_effective_at_f .

bpm:bundle_conflict_bundle_conflict_id_f a bpm:Field ;
    bpm:fieldName "bundle_conflict_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this bundle conflict contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:bundle_conflict_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:bundle_conflict_conflicting_bundle_id_f a bpm:Field ;
    bpm:fieldName "conflicting_bundle_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Bundle whose simultaneous activation must be refused." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:bundle_conflict_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:bundle_conflict_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
