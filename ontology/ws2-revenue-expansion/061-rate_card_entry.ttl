@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-061 — rate_card_entry
bpm:rate_card_entry_rt a bpm:RecordType ;
    bpm:recordName "rate_card_entry" ;
    bpm:recordDoc "Sellable unit price bound to an immutable price book." ;
    bpm:hasField bpm:rate_card_entry_rate_card_entry_id_f,
                 bpm:rate_card_entry_account_id_f,
                 bpm:rate_card_entry_unit_price_f,
                 bpm:rate_card_entry_evidence_digest_f,
                 bpm:rate_card_entry_effective_at_f .

bpm:rate_card_entry_rate_card_entry_id_f a bpm:Field ;
    bpm:fieldName "rate_card_entry_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this rate card entry contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:rate_card_entry_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:rate_card_entry_unit_price_f a bpm:Field ;
    bpm:fieldName "unit_price" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Admitted unit price; currency is supplied by the linked currency policy." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:rate_card_entry_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:rate_card_entry_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
