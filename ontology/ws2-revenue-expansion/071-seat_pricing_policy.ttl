@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-071 — seat_pricing_policy
bpm:seat_pricing_policy_rt a bpm:RecordType ;
    bpm:recordName "seat_pricing_policy" ;
    bpm:recordDoc "Named-seat enterprise packaging dimension." ;
    bpm:hasField bpm:seat_pricing_policy_seat_pricing_policy_id_f,
                 bpm:seat_pricing_policy_account_id_f,
                 bpm:seat_pricing_policy_seat_price_f,
                 bpm:seat_pricing_policy_evidence_digest_f,
                 bpm:seat_pricing_policy_effective_at_f .

bpm:seat_pricing_policy_seat_pricing_policy_id_f a bpm:Field ;
    bpm:fieldName "seat_pricing_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this seat pricing policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:seat_pricing_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:seat_pricing_policy_seat_price_f a bpm:Field ;
    bpm:fieldName "seat_price" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Admitted unit price for one named enterprise seat." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:seat_pricing_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:seat_pricing_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
