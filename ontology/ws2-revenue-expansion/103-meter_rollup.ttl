@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-103 — meter_rollup
bpm:meter_rollup_rt a bpm:RecordType ;
    bpm:recordName "meter_rollup" ;
    bpm:recordDoc "Deterministic rollup policy for metered observations." ;
    bpm:hasField bpm:meter_rollup_meter_rollup_id_f,
                 bpm:meter_rollup_account_id_f,
                 bpm:meter_rollup_rollup_function_f,
                 bpm:meter_rollup_evidence_digest_f,
                 bpm:meter_rollup_effective_at_f .

bpm:meter_rollup_meter_rollup_id_f a bpm:Field ;
    bpm:fieldName "meter_rollup_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this meter rollup contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:meter_rollup_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:meter_rollup_rollup_function_f a bpm:Field ;
    bpm:fieldName "rollup_function" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Admitted aggregation function identity." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:meter_rollup_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:meter_rollup_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
