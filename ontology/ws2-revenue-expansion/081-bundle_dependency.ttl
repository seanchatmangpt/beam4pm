@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-081 — bundle_dependency
bpm:bundle_dependency_rt a bpm:RecordType ;
    bpm:recordName "bundle_dependency" ;
    bpm:recordDoc "Required dependency between sellable bundles." ;
    bpm:hasField bpm:bundle_dependency_bundle_dependency_id_f,
                 bpm:bundle_dependency_account_id_f,
                 bpm:bundle_dependency_required_bundle_id_f,
                 bpm:bundle_dependency_evidence_digest_f,
                 bpm:bundle_dependency_effective_at_f .

bpm:bundle_dependency_bundle_dependency_id_f a bpm:Field ;
    bpm:fieldName "bundle_dependency_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this bundle dependency contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:bundle_dependency_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:bundle_dependency_required_bundle_id_f a bpm:Field ;
    bpm:fieldName "required_bundle_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Bundle that must be entitled before this bundle can activate." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:bundle_dependency_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:bundle_dependency_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
