@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-106 — overage_invoice
bpm:overage_invoice_rt a bpm:RecordType ;
    bpm:recordName "overage_invoice" ;
    bpm:recordDoc "Invoice consequence for measured overage." ;
    bpm:hasField bpm:overage_invoice_overage_invoice_id_f,
                 bpm:overage_invoice_account_id_f,
                 bpm:overage_invoice_overage_amount_f,
                 bpm:overage_invoice_evidence_digest_f,
                 bpm:overage_invoice_effective_at_f .

bpm:overage_invoice_overage_invoice_id_f a bpm:Field ;
    bpm:fieldName "overage_invoice_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this overage invoice contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:overage_invoice_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:overage_invoice_overage_amount_f a bpm:Field ;
    bpm:fieldName "overage_amount" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Observed overage amount after admitted aggregation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:overage_invoice_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:overage_invoice_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
