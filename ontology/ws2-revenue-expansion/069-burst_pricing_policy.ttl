@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-069 — burst_pricing_policy
bpm:burst_pricing_policy_rt a bpm:RecordType ;
    bpm:recordName "burst_pricing_policy" ;
    bpm:recordDoc "Bounded burst-capacity premium." ;
    bpm:hasField bpm:burst_pricing_policy_burst_pricing_policy_id_f,
                 bpm:burst_pricing_policy_account_id_f,
                 bpm:burst_pricing_policy_burst_multiplier_f,
                 bpm:burst_pricing_policy_evidence_digest_f,
                 bpm:burst_pricing_policy_effective_at_f .

bpm:burst_pricing_policy_burst_pricing_policy_id_f a bpm:Field ;
    bpm:fieldName "burst_pricing_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this burst pricing policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:burst_pricing_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:burst_pricing_policy_burst_multiplier_f a bpm:Field ;
    bpm:fieldName "burst_multiplier" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Approved multiplier applied only above the included capacity." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:burst_pricing_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:burst_pricing_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
