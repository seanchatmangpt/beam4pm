@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-088 — nonproduction_discount_policy
bpm:nonproduction_discount_policy_rt a bpm:RecordType ;
    bpm:recordName "nonproduction_discount_policy" ;
    bpm:recordDoc "Explicit discount for nonproduction capacity." ;
    bpm:hasField bpm:nonproduction_discount_policy_nonproduction_discount_policy_id_f,
                 bpm:nonproduction_discount_policy_account_id_f,
                 bpm:nonproduction_discount_policy_discount_percent_f,
                 bpm:nonproduction_discount_policy_evidence_digest_f,
                 bpm:nonproduction_discount_policy_effective_at_f .

bpm:nonproduction_discount_policy_nonproduction_discount_policy_id_f a bpm:Field ;
    bpm:fieldName "nonproduction_discount_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this nonproduction discount policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:nonproduction_discount_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:nonproduction_discount_policy_discount_percent_f a bpm:Field ;
    bpm:fieldName "discount_percent" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Approved nonproduction discount percentage." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:nonproduction_discount_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:nonproduction_discount_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
