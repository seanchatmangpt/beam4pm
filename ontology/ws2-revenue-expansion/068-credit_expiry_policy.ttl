@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-068 — credit_expiry_policy
bpm:credit_expiry_policy_rt a bpm:RecordType ;
    bpm:recordName "credit_expiry_policy" ;
    bpm:recordDoc "Deterministic expiration of prepaid commercial credits." ;
    bpm:hasField bpm:credit_expiry_policy_credit_expiry_policy_id_f,
                 bpm:credit_expiry_policy_account_id_f,
                 bpm:credit_expiry_policy_expires_at_f,
                 bpm:credit_expiry_policy_evidence_digest_f,
                 bpm:credit_expiry_policy_effective_at_f .

bpm:credit_expiry_policy_credit_expiry_policy_id_f a bpm:Field ;
    bpm:fieldName "credit_expiry_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this credit expiry policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:credit_expiry_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:credit_expiry_policy_expires_at_f a bpm:Field ;
    bpm:fieldName "expires_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "Exact expiration instant for the admitted credit pool." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:credit_expiry_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:credit_expiry_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
