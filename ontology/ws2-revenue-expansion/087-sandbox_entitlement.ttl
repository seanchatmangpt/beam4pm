@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-087 — sandbox_entitlement
bpm:sandbox_entitlement_rt a bpm:RecordType ;
    bpm:recordName "sandbox_entitlement" ;
    bpm:recordDoc "Nonproduction sandbox entitlement with a hard ceiling." ;
    bpm:hasField bpm:sandbox_entitlement_sandbox_entitlement_id_f,
                 bpm:sandbox_entitlement_account_id_f,
                 bpm:sandbox_entitlement_sandbox_limit_f,
                 bpm:sandbox_entitlement_evidence_digest_f,
                 bpm:sandbox_entitlement_effective_at_f .

bpm:sandbox_entitlement_sandbox_entitlement_id_f a bpm:Field ;
    bpm:fieldName "sandbox_entitlement_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this sandbox entitlement contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:sandbox_entitlement_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:sandbox_entitlement_sandbox_limit_f a bpm:Field ;
    bpm:fieldName "sandbox_limit" ; bpm:fieldType "integer" ;
    bpm:fieldDoc "Maximum purchased sandbox environments." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:sandbox_entitlement_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:sandbox_entitlement_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
