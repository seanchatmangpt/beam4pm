@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-107 — cost_center_allocation
bpm:cost_center_allocation_rt a bpm:RecordType ;
    bpm:recordName "cost_center_allocation" ;
    bpm:recordDoc "Chargeback allocation to an enterprise cost center." ;
    bpm:hasField bpm:cost_center_allocation_cost_center_allocation_id_f,
                 bpm:cost_center_allocation_account_id_f,
                 bpm:cost_center_allocation_cost_center_id_f,
                 bpm:cost_center_allocation_evidence_digest_f,
                 bpm:cost_center_allocation_effective_at_f .

bpm:cost_center_allocation_cost_center_allocation_id_f a bpm:Field ;
    bpm:fieldName "cost_center_allocation_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this cost center allocation contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:cost_center_allocation_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:cost_center_allocation_cost_center_id_f a bpm:Field ;
    bpm:fieldName "cost_center_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of the charged cost center." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:cost_center_allocation_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:cost_center_allocation_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
