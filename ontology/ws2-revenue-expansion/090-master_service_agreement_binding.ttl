@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-090 — master_service_agreement_binding
bpm:master_service_agreement_binding_rt a bpm:RecordType ;
    bpm:recordName "master_service_agreement_binding" ;
    bpm:recordDoc "Exact MSA binding for an order." ;
    bpm:hasField bpm:master_service_agreement_binding_master_service_agreement_binding_id_f,
                 bpm:master_service_agreement_binding_account_id_f,
                 bpm:master_service_agreement_binding_msa_digest_f,
                 bpm:master_service_agreement_binding_evidence_digest_f,
                 bpm:master_service_agreement_binding_effective_at_f .

bpm:master_service_agreement_binding_master_service_agreement_binding_id_f a bpm:Field ;
    bpm:fieldName "master_service_agreement_binding_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this master service agreement binding contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:master_service_agreement_binding_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:master_service_agreement_binding_msa_digest_f a bpm:Field ;
    bpm:fieldName "msa_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Content digest of the governing master service agreement." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:master_service_agreement_binding_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:master_service_agreement_binding_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
