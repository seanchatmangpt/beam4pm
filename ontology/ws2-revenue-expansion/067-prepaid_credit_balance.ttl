@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-067 — prepaid_credit_balance
bpm:prepaid_credit_balance_rt a bpm:RecordType ;
    bpm:recordName "prepaid_credit_balance" ;
    bpm:recordDoc "Receipted prepaid-credit balance." ;
    bpm:hasField bpm:prepaid_credit_balance_prepaid_credit_balance_id_f,
                 bpm:prepaid_credit_balance_account_id_f,
                 bpm:prepaid_credit_balance_remaining_credit_f,
                 bpm:prepaid_credit_balance_evidence_digest_f,
                 bpm:prepaid_credit_balance_effective_at_f .

bpm:prepaid_credit_balance_prepaid_credit_balance_id_f a bpm:Field ;
    bpm:fieldName "prepaid_credit_balance_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this prepaid credit balance contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:prepaid_credit_balance_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:prepaid_credit_balance_remaining_credit_f a bpm:Field ;
    bpm:fieldName "remaining_credit" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Observed remaining prepaid credit after admitted usage." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:prepaid_credit_balance_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:prepaid_credit_balance_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
