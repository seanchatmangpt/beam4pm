@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-062 — currency_policy
bpm:currency_policy_rt a bpm:RecordType ;
    bpm:recordName "currency_policy" ;
    bpm:recordDoc "Allowed billing currency for an enterprise agreement." ;
    bpm:hasField bpm:currency_policy_currency_policy_id_f,
                 bpm:currency_policy_account_id_f,
                 bpm:currency_policy_currency_code_f,
                 bpm:currency_policy_evidence_digest_f,
                 bpm:currency_policy_effective_at_f .

bpm:currency_policy_currency_policy_id_f a bpm:Field ;
    bpm:fieldName "currency_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this currency policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:currency_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:currency_policy_currency_code_f a bpm:Field ;
    bpm:fieldName "currency_code" ; bpm:fieldType "string" ;
    bpm:fieldDoc "ISO billing currency admitted for this account." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:currency_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:currency_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
