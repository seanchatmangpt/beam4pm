@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-074 — object_volume_pricing_policy
bpm:object_volume_pricing_policy_rt a bpm:RecordType ;
    bpm:recordName "object_volume_pricing_policy" ;
    bpm:recordDoc "Object-volume commercial packaging dimension." ;
    bpm:hasField bpm:object_volume_pricing_policy_object_volume_pricing_policy_id_f,
                 bpm:object_volume_pricing_policy_account_id_f,
                 bpm:object_volume_pricing_policy_unit_object_price_f,
                 bpm:object_volume_pricing_policy_evidence_digest_f,
                 bpm:object_volume_pricing_policy_effective_at_f .

bpm:object_volume_pricing_policy_object_volume_pricing_policy_id_f a bpm:Field ;
    bpm:fieldName "object_volume_pricing_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this object volume pricing policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:object_volume_pricing_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:object_volume_pricing_policy_unit_object_price_f a bpm:Field ;
    bpm:fieldName "unit_object_price" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Admitted unit price per object billing unit." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:object_volume_pricing_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:object_volume_pricing_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
