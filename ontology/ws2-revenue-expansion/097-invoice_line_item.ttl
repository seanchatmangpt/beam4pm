@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-097 — invoice_line_item
bpm:invoice_line_item_rt a bpm:RecordType ;
    bpm:recordName "invoice_line_item" ;
    bpm:recordDoc "Auditable commercial invoice line." ;
    bpm:hasField bpm:invoice_line_item_invoice_line_item_id_f,
                 bpm:invoice_line_item_account_id_f,
                 bpm:invoice_line_item_line_amount_f,
                 bpm:invoice_line_item_evidence_digest_f,
                 bpm:invoice_line_item_effective_at_f .

bpm:invoice_line_item_invoice_line_item_id_f a bpm:Field ;
    bpm:fieldName "invoice_line_item_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this invoice line item contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:invoice_line_item_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:invoice_line_item_line_amount_f a bpm:Field ;
    bpm:fieldName "line_amount" ; bpm:fieldType "float" ;
    bpm:fieldDoc "Observed amount for this exact invoice line." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:invoice_line_item_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:invoice_line_item_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
