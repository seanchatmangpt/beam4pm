@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-076 — environment_pricing_policy
bpm:environment_pricing_policy_rt a bpm:RecordType ;
    bpm:recordName "environment_pricing_policy" ;
    bpm:recordDoc "Environment-count commercial packaging." ;
    bpm:hasField bpm:environment_pricing_policy_environment_pricing_policy_id_f,
                 bpm:environment_pricing_policy_account_id_f,
                 bpm:environment_pricing_policy_environment_tier_f,
                 bpm:environment_pricing_policy_evidence_digest_f,
                 bpm:environment_pricing_policy_effective_at_f .

bpm:environment_pricing_policy_environment_pricing_policy_id_f a bpm:Field ;
    bpm:fieldName "environment_pricing_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this environment pricing policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:environment_pricing_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:environment_pricing_policy_environment_tier_f a bpm:Field ;
    bpm:fieldName "environment_tier" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Purchased environment tier such as sandbox, nonproduction, or production." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:environment_pricing_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:environment_pricing_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
