@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-098 — usage_aggregation_window
bpm:usage_aggregation_window_rt a bpm:RecordType ;
    bpm:recordName "usage_aggregation_window" ;
    bpm:recordDoc "Deterministic usage aggregation window." ;
    bpm:hasField bpm:usage_aggregation_window_usage_aggregation_window_id_f,
                 bpm:usage_aggregation_window_account_id_f,
                 bpm:usage_aggregation_window_window_seconds_f,
                 bpm:usage_aggregation_window_evidence_digest_f,
                 bpm:usage_aggregation_window_effective_at_f .

bpm:usage_aggregation_window_usage_aggregation_window_id_f a bpm:Field ;
    bpm:fieldName "usage_aggregation_window_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this usage aggregation window contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:usage_aggregation_window_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:usage_aggregation_window_window_seconds_f a bpm:Field ;
    bpm:fieldName "window_seconds" ; bpm:fieldType "integer" ;
    bpm:fieldDoc "Exact billing aggregation window in seconds." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:usage_aggregation_window_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:usage_aggregation_window_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
