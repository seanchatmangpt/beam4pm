@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-093 — proration_policy
bpm:proration_policy_rt a bpm:RecordType ;
    bpm:recordName "proration_policy" ;
    bpm:recordDoc "Deterministic mid-term proration policy." ;
    bpm:hasField bpm:proration_policy_proration_policy_id_f,
                 bpm:proration_policy_account_id_f,
                 bpm:proration_policy_proration_method_f,
                 bpm:proration_policy_evidence_digest_f,
                 bpm:proration_policy_effective_at_f .

bpm:proration_policy_proration_policy_id_f a bpm:Field ;
    bpm:fieldName "proration_policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this proration policy contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:proration_policy_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:proration_policy_proration_method_f a bpm:Field ;
    bpm:fieldName "proration_method" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Admitted algorithm identity for partial-period charges." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:proration_policy_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:proration_policy_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
