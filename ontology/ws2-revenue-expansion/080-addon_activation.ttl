@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-080 — addon_activation
bpm:addon_activation_rt a bpm:RecordType ;
    bpm:recordName "addon_activation" ;
    bpm:recordDoc "Receipted activation of a paid add-on." ;
    bpm:hasField bpm:addon_activation_addon_activation_id_f,
                 bpm:addon_activation_account_id_f,
                 bpm:addon_activation_addon_id_f,
                 bpm:addon_activation_evidence_digest_f,
                 bpm:addon_activation_effective_at_f .

bpm:addon_activation_addon_activation_id_f a bpm:Field ;
    bpm:fieldName "addon_activation_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this addon activation contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:addon_activation_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:addon_activation_addon_id_f a bpm:Field ;
    bpm:fieldName "addon_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of the activated commercial add-on." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:addon_activation_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:addon_activation_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
