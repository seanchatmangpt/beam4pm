@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .

# WS2-REV-100 — late_arriving_usage
bpm:late_arriving_usage_rt a bpm:RecordType ;
    bpm:recordName "late_arriving_usage" ;
    bpm:recordDoc "Admission of usage received after its billing window." ;
    bpm:hasField bpm:late_arriving_usage_late_arriving_usage_id_f,
                 bpm:late_arriving_usage_account_id_f,
                 bpm:late_arriving_usage_occurred_at_f,
                 bpm:late_arriving_usage_evidence_digest_f,
                 bpm:late_arriving_usage_effective_at_f .

bpm:late_arriving_usage_late_arriving_usage_id_f a bpm:Field ;
    bpm:fieldName "late_arriving_usage_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable identity of this late arriving usage contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

bpm:late_arriving_usage_account_id_f a bpm:Field ;
    bpm:fieldName "account_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Enterprise account governed by this commercial contract." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

bpm:late_arriving_usage_occurred_at_f a bpm:Field ;
    bpm:fieldName "occurred_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "Original occurrence instant for the delayed usage." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

bpm:late_arriving_usage_evidence_digest_f a bpm:Field ;
    bpm:fieldName "evidence_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the exact evidence admitting this commercial consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:late_arriving_usage_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 instant at which this contract becomes effective." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
