@prefix bpm: <https://beam4pm.dev/ontology/process#> .

# WS2-BB-149 — scheduling_priority_score
bpm:scheduling_priority_score_rt a bpm:RecordType ;
    bpm:recordName "scheduling_priority_score" ;
    bpm:recordDoc "Computes transparent next-work priority from value, delay, information, and reversibility." ;
    bpm:hasField bpm:scheduling_priority_score_score_id_f ,
                 bpm:scheduling_priority_score_work_item_id_f ,
                 bpm:scheduling_priority_score_component_digest_f .

bpm:scheduling_priority_score_score_id_f a bpm:Field ;
    bpm:fieldName "score_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Priority score identity." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:scheduling_priority_score_work_item_id_f a bpm:Field ;
    bpm:fieldName "work_item_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Bounded work item scored." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:scheduling_priority_score_component_digest_f a bpm:Field ;
    bpm:fieldName "component_digest" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of normalized score components." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .
