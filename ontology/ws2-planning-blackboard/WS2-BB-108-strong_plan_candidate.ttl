@prefix bpm: <https://beam4pm.dev/ontology/process#> .

# WS2-BB-108 — strong_plan_candidate
bpm:strong_plan_candidate_rt a bpm:RecordType ;
    bpm:recordName "strong_plan_candidate" ;
    bpm:recordDoc "Records a policy candidate that reaches the goal under every admitted outcome." ;
    bpm:hasField bpm:strong_plan_candidate_candidate_id_f ,
                 bpm:strong_plan_candidate_policy_digest_f ,
                 bpm:strong_plan_candidate_coverage_proof_f .

bpm:strong_plan_candidate_candidate_id_f a bpm:Field ;
    bpm:fieldName "candidate_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Strong plan candidate identity." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:strong_plan_candidate_policy_digest_f a bpm:Field ;
    bpm:fieldName "policy_digest" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of the policy graph." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:strong_plan_candidate_coverage_proof_f a bpm:Field ;
    bpm:fieldName "coverage_proof" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Evidence covering every admitted outcome." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .
