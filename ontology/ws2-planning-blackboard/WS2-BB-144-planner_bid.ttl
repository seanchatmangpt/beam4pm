@prefix bpm: <https://beam4pm.dev/ontology/process#> .

# WS2-BB-144 — planner_bid
bpm:planner_bid_rt a bpm:RecordType ;
    bpm:recordName "planner_bid" ;
    bpm:recordDoc "Bids for bounded work using declared cost, confidence, and capsule identity." ;
    bpm:hasField bpm:planner_bid_bid_id_f ,
                 bpm:planner_bid_work_item_id_f ,
                 bpm:planner_bid_score_digest_f .

bpm:planner_bid_bid_id_f a bpm:Field ;
    bpm:fieldName "bid_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Planner bid identity." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:planner_bid_work_item_id_f a bpm:Field ;
    bpm:fieldName "work_item_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Bounded work item being bid." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:planner_bid_score_digest_f a bpm:Field ;
    bpm:fieldName "score_digest" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of cost, confidence, and evidence scores." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .
