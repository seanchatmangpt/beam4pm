@prefix bpm: <https://beam4pm.dev/ontology/process#> .

# WS2-BB-106 — outcome_branch_set
bpm:outcome_branch_set_rt a bpm:RecordType ;
    bpm:recordName "outcome_branch_set" ;
    bpm:recordDoc "Declares the finite outcome branches an action may produce." ;
    bpm:hasField bpm:outcome_branch_set_action_id_f ,
                 bpm:outcome_branch_set_branch_digest_f ,
                 bpm:outcome_branch_set_coverage_mode_f .

bpm:outcome_branch_set_action_id_f a bpm:Field ;
    bpm:fieldName "action_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Candidate action identity." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:outcome_branch_set_branch_digest_f a bpm:Field ;
    bpm:fieldName "branch_digest" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Digest of ordered possible outcomes." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:outcome_branch_set_coverage_mode_f a bpm:Field ;
    bpm:fieldName "coverage_mode" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Declared completeness mode for branches." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .
