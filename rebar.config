%% rebar.config for beam4pm
%%
%% All Erlang source -- hand-authored (src/beam4pm.app.src) and
%% ggen-manufactured alike -- lives in the standard rebar3 src/ and test/
%% directories. Manufactured provenance is signalled per-file by the
%% "GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit."
%% header comment, never by directory placement -- ggen output is not a
%% second-class citizen sitting outside the project's real source tree. See
%% CONTRIBUTING.md for the source-authority rule this implies (edit
%% ontology.ttl or the pack's templates, never a file carrying that header,
%% regardless of which directory it lives in).

{erl_opts, [debug_info]}.

{eunit_opts, [verbose]}.
