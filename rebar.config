%% rebar.config for beam4pm
%%
%% Process-mining source lives outside the default src/ directory -- it is
%% ggen-manufactured output under generated/erlang/src and
%% generated/erlang/test (see generated/README.md), never hand-edited. The
%% app resource file itself (src/beam4pm.app.src) is hand-authored project
%% scaffolding, the same category as this file and mix.exs.
%%
%% rebar3 discovers the `beam4pm` OTP application via src/beam4pm.app.src;
%% `src_dirs` then tells it to ALSO compile generated/erlang/src into that
%% same application (real, standard rebar3 mechanism -- src_dirs accepts a
%% list, not just the default ["src"]). `profiles.test.extra_src_dirs` adds
%% generated/erlang/test only when the `test` profile is active, which
%% `rebar3 eunit` activates automatically.

{erl_opts, [debug_info]}.

{src_dirs, ["src", "generated/erlang/src"]}.

{profiles, [
    {test, [
        {extra_src_dirs, ["generated/erlang/test"]}
    ]}
]}.

{eunit_opts, [verbose]}.
