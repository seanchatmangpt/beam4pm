# Justfile — Operator Surface for beam4pm

# Default recipe: print help / recipes
default:
    @just --list

# Initialize/update vendored submodules (vendor/ggen-marketplace)
submodules:
    git submodule update --init --recursive

# Regenerate ggen.lock from a clean slate, dry-run first, then run for real
sync:
    rm -f ggen.lock
    ggen sync run --dry-run
    ggen sync run

# Run the BEAM test suites: rebar3 eunit for Erlang, mix test for Elixir
test:
    rebar3 eunit
    mix test

# VISION-2030 section 5: zero-configuration discovery. Point at an arbitrary
# XES or OCEL 2.0 JSON file and get a real discovery report (traces, DFG,
# variants, conformance) -- no bespoke modeling engagement in between.
# Usage: just discover qualification/fixtures/small-example.xes
discover path:
    mix run scripts/discover_report.exs {{path}}

# Static scan of hand-authored docs/source for banned overclaiming phrases
# (transplanted architecture from ex4pm's `mix ex4pm.lint.truth`).
lint_truth:
    bash scripts/gate_lint_truth.sh

# Audit every real mix.exs against the two known Igniter defect trigger
# shapes (B4PM-1701): inline deps: [...] vs defp deps do ... end, and any
# parenless zero-arity / guarded def inside mix.exs itself. Emits a
# machine-readable JSON report and self-tests its own detector against a
# real positive fixture before auditing.
mixexs_defect_audit:
    bash scripts/mixexs_defect_audit.sh

# GATE AUTHORSHIP: every file under a manufactured root that carries no
# GENERATED marker must be an admitted, counted bpm:HandAuthoredSource
# (manifest schema/beam4pm_hand_authored_source.tsv, regenerated by sync).
authorship:
    bash scripts/gate_authorship_check.sh

# GATE AUTHORSHIP --exercise: also run every admitted acceptance command and
# refuse a failing or vacuous (all-skipped) one unless its declared
# prerequisite artifact is absent on this host.
authorship_exercise:
    bash scripts/gate_authorship_check.sh --exercise

# GATE ENGINE DISPATCH: every manufactured native-engine facade op (rendered
# from the bpm:Engine facts in ontology.ttl) must be an op the engine's crate
# dispatches (manifest schema/beam4pm_engine_ops.tsv, regenerated by sync).
engine_dispatch:
    bash scripts/gate_engine_dispatch_check.sh

# Full operator chain: submodules -> sync -> authorship -> engine_dispatch ->
# lint_truth -> mixexs_defect_audit -> test
verify: submodules sync authorship engine_dispatch lint_truth mixexs_defect_audit test
