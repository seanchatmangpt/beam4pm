    bpm:argOp bap:engine_ferroplan_op_session_plan_valid ; bpm:argName "plan" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_map .
bap:engine_ferroplan_op_session_plan_valid_from a bpm:EngineArg ;
    bpm:argOp bap:engine_ferroplan_op_session_plan_valid ; bpm:argName "from" ; bpm:argOrder 3 ; bpm:argType bpm:EngineArgType_integer .

bap:engine_ferroplan_op_session_world_bytes a bpm:EngineOp ;
    bpm:opEngine bap:engine_ferroplan ; bpm:opName "session_world_bytes" ; bpm:opOrder 29 ;
    bpm:opDoc "`{\"op\":\"session_world_bytes\",\"handle\":h}` -- byte size of the shared/grounded world state." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_ferroplan_op_session_world_bytes_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_ferroplan_op_session_world_bytes ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_ferroplan_op_session_mind_bytes a bpm:EngineOp ;
    bpm:opEngine bap:engine_ferroplan ; bpm:opName "session_mind_bytes" ; bpm:opOrder 30 ;
    bpm:opDoc "`{\"op\":\"session_mind_bytes\",\"handle\":h}` -- byte size of this session's private mutable state." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_ferroplan_op_session_mind_bytes_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_ferroplan_op_session_mind_bytes ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_ferroplan_op_htn_plan a bpm:EngineOp ;
    bpm:opEngine bap:engine_ferroplan ; bpm:opName "htn_plan" ; bpm:opOrder 31 ;
    bpm:opDoc "`{\"op\":\"htn_plan\",\"domain\":d,\"problem\":p[,\"limits\":l]}` -- hierarchical task network (HTN) decomposition, PlanningType::Hierarchical via solve_planning_type. `problem` is JSON text of a PlanningProblem (not PDDL). Returns `{:ok, <UniversalPlan map>}`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
