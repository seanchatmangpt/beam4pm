    bpm:fieldDoc "Exact runtime subject identity required for independent verification and replay." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:workload_idempotency_key_idempotency_key_f a bpm:Field ;
    bpm:fieldName "idempotency_key" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Immutable evidence identity binding the observed production consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

# WS3-REV-007 — workload_retry_policy
b4p:workload_retry_policy_rt a bpm:RecordType ;
    bpm:recordName "workload_retry_policy" ;
    bpm:recordDoc "Admits a bounded retry policy with explicit identity and replayable configuration evidence." ;
    bpm:hasField b4p:workload_retry_policy_tenant_id_f,
                 b4p:workload_retry_policy_policy_id_f,
                 b4p:workload_retry_policy_policy_hash_f .

b4p:workload_retry_policy_tenant_id_f a bpm:Field ;
    bpm:fieldName "tenant_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact paid tenant identity for this bounded runtime observation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:workload_retry_policy_policy_id_f a bpm:Field ;
    bpm:fieldName "policy_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact runtime subject identity required for independent verification and replay." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:workload_retry_policy_policy_hash_f a bpm:Field ;
    bpm:fieldName "policy_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Immutable evidence identity binding the observed production consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

# WS3-REV-008 — workload_timeout_budget
b4p:workload_timeout_budget_rt a bpm:RecordType ;
    bpm:recordName "workload_timeout_budget" ;
    bpm:recordDoc "Admits an execution timeout budget that prevents unbounded paid runtime consumption." ;
    bpm:hasField b4p:workload_timeout_budget_tenant_id_f,
                 b4p:workload_timeout_budget_budget_id_f,
                 b4p:workload_timeout_budget_budget_hash_f .

b4p:workload_timeout_budget_tenant_id_f a bpm:Field ;
    bpm:fieldName "tenant_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact paid tenant identity for this bounded runtime observation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:workload_timeout_budget_budget_id_f a bpm:Field ;
    bpm:fieldName "budget_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact runtime subject identity required for independent verification and replay." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:workload_timeout_budget_budget_hash_f a bpm:Field ;
    bpm:fieldName "budget_hash" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Immutable evidence identity binding the observed production consequence." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
