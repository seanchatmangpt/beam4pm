# ===========================================================================
# Native engine surfaces -- ADMITTED as facts, facades MANUFACTURED
# (2026-09-05; VISION-2030 section 2 / section 24 falsifier "ggen-only
# manufacture requires routine privileged handwritten source commits").
#
# The bpm:HandAuthoredSource admissions above counted the four native-engine
# facade triples (src/beam4pm_<engine>.erl, lib/beam4pm_<engine>.ex,
# gleam/src/beam4pm/<engine>.gleam) as 12 of the 26 debt files, each with the
# sunset plan "admit the engine's function surface as ontology facts and
# render all three facades from one pack template family". This block IS
# that sunset, engine by engine: every op, its wire name, its args (closed
# bpm:EngineArgType / bpm:ArgEncoding / bpm:ArgMode members), its timeout
# class and its per-leg exposure are declared here; the vendored pack's
# templates/beam4pm_engine.{ex,erl,gleam}.tmpl render the three facades and
# templates/beam4pm_engine_ops.tsv.tmpl renders schema/beam4pm_engine_ops.tsv,
# which scripts/gate_engine_dispatch_check.sh diffs against the crate's own
# string-literal `"<op>" =>` dispatch arms (bpm:dispatchSource) -- an
# EngineOp the crate does not dispatch is a refusal, and a crate arm this
# block does not expose is reported (never silently exposed: scope control).
#
# Derivation: the initial facts below were transcribed from the hand-authored
# facades they replace (deleted in the same commit, their three admissions
# removed above so GATE AUTHORSHIP's counted debt drops by 3 per engine) and
# checked against the crate dispatch sets; from here on THIS block is the
# source of truth and the facades are consequences. Behavioral identity is
# proven by the unchanged, sha-pinned facades parity suites
# (test/beam4pm_<engine>_facades_test.exs) against the real wasm engines.
#
# Converted: petgraph, tract, ferroplan, rust4pm -- all four native engines.
# native_engine_facade debt is now 0 admitted (declared ceiling unchanged at
# 6 in the vendored pack; see the debt-admissions section above for why).
# ===========================================================================

@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix bap: <https://ggen.dev/projects/beam4pm#> .

# -- petgraph (native/petgraph-wasm): graph algorithms -----------------------

bap:engine_petgraph a bpm:Engine ;
    bpm:engineName "petgraph" ;
    bpm:engineModule "Petgraph" ;
    bpm:engineDoc "A real graph-algorithms engine (the petgraph crate, native/petgraph-wasm): Dijkstra via A*, Tarjan strongly-connected components, topological sort and cycle detection over the DFGs and Petri nets `BeamPM.Rust4PM` discovers, without reimplementing any graph algorithm on the BEAM side." ;
    bpm:engineOrdinal 3 ;
    bpm:wasmExportPrefix "pg" ;
    bpm:wasmArtifactPath "native/petgraph-wasm/target/wasm32-wasip1/release/petgraph_wasm.wasm" ;
    bpm:wasmBuildScript "scripts/petgraph_wasm_build.sh" ;
    bpm:dispatchSource "native/petgraph-wasm/src/lib.rs" ;
    bpm:healthId "petgraph_wasm" ;
    bpm:handleNoun "graph" ;
    bpm:cheapTimeoutMs 30000 ;
    bpm:errorCollapse bpm:ErrorCollapse_single_key_inspect .

bap:engine_petgraph_op_graph_new a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "graph_new" ; bpm:opOrder 1 ;
    bpm:opDoc "`{\"op\":\"graph_new\"}` -- a new, empty directed graph. `{:ok, %{\"handle\" => n}}`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .

bap:engine_petgraph_op_add_node a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "add_node" ; bpm:opOrder 2 ;
    bpm:opDoc "`{\"op\":\"add_node\",\"handle\":h,\"name\":n}` -- idempotent." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_petgraph_op_add_node_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_add_node ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bap:engine_petgraph_op_add_node_name a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_add_node ; bpm:argName "name" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_string .

bap:engine_petgraph_op_add_edge a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "add_edge" ; bpm:opOrder 3 ;
    bpm:opDoc "`{\"op\":\"add_edge\",\"handle\":h,\"from\":f,\"to\":t,\"weight\":w}` -- auto-adds `from`/`to` as nodes if absent. `weight` is the `:weight` keyword option, default 1.0 (Erlang: add_edge/4 takes it explicitly; Gleam binds the default-weight head only)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_petgraph_op_add_edge_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_add_edge ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bap:engine_petgraph_op_add_edge_from a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_add_edge ; bpm:argName "from" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_string .
bap:engine_petgraph_op_add_edge_to a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_add_edge ; bpm:argName "to" ; bpm:argOrder 3 ; bpm:argType bpm:EngineArgType_string .
bap:engine_petgraph_op_add_edge_weight a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_add_edge ; bpm:argName "weight" ; bpm:argOrder 4 ;
    bpm:argType bpm:EngineArgType_number ; bpm:argMode bpm:ArgMode_keyword ; bpm:argDefault "1.0" .

bap:engine_petgraph_op_shortest_path a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "shortest_path" ; bpm:opOrder 4 ;
    bpm:opDoc "`{\"op\":\"shortest_path\",\"handle\":h,\"from\":f,\"to\":t}` -- real A*-as-Dijkstra. `{:ok, %{\"path\" => [names], \"cost\" => f64}}` on a real path, or `{:ok, %{\"path\" => nil, \"cost\" => nil}}` when unreachable or a name is unknown -- \"no path\" is an answer, not an error. Negative edge weights are refused with a real `{:error, {:engine, _}}`, never silently mishandled." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_petgraph_op_shortest_path_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_shortest_path ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bap:engine_petgraph_op_shortest_path_from a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_shortest_path ; bpm:argName "from" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_string .
bap:engine_petgraph_op_shortest_path_to a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_shortest_path ; bpm:argName "to" ; bpm:argOrder 3 ; bpm:argType bpm:EngineArgType_string .

bap:engine_petgraph_op_scc a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "scc" ; bpm:opOrder 5 ;
    bpm:opDoc "`{\"op\":\"scc\",\"handle\":h}` -- Tarjan strongly-connected-components, deterministically sorted (each component's node list sorted, components sorted by their sorted list)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_petgraph_op_scc_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_scc ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_petgraph_op_toposort a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "toposort" ; bpm:opOrder 6 ;
    bpm:opDoc "`{\"op\":\"toposort\",\"handle\":h}` -- `{:ok, %{\"acyclic\" => true, \"order\" => [names]}}` or `{:ok, %{\"acyclic\" => false, \"order\" => nil}}`. A cycle is a real, named answer, never an error." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_petgraph_op_toposort_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_toposort ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_petgraph_op_is_cyclic a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "is_cyclic" ; bpm:opOrder 7 ;
    bpm:opDoc "`{\"op\":\"is_cyclic\",\"handle\":h}` -- `{:ok, %{\"cyclic\" => bool}}`. Elixir names it `is_cyclic?`; Erlang and Gleam keep `is_cyclic`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire ;
    bpm:opElixirPredicate "true" .
bap:engine_petgraph_op_is_cyclic_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_is_cyclic ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_petgraph_op_node_count a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "node_count" ; bpm:opOrder 8 ;
    bpm:opDoc "`{\"op\":\"node_count\",\"handle\":h}` -- node count of the graph." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_petgraph_op_node_count_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_node_count ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_petgraph_op_edge_count a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "edge_count" ; bpm:opOrder 9 ;
    bpm:opDoc "`{\"op\":\"edge_count\",\"handle\":h}` -- edge count of the graph." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_petgraph_op_edge_count_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_edge_count ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_petgraph_op_free_graph a bpm:EngineOp ;
    bpm:opEngine bap:engine_petgraph ; bpm:opName "free_graph" ; bpm:opOrder 10 ;
    bpm:opDoc "`{\"op\":\"free_graph\",\"handle\":h}` -- releases the graph handle; subsequent use errors with an unknown-handle message." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_petgraph_op_free_graph_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_petgraph_op_free_graph ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

# -- tract (native/tract-wasm): ONNX inference --------------------------------

bap:engine_tract a bpm:Engine ;
    bpm:engineName "tract" ;
    bpm:engineModule "Tract" ;
    bpm:engineDoc "A real ONNX-inference engine (sonos/tract -- the same crate Wasmtime's own WASI-NN implementation uses for this exact target, native/tract-wasm): graph optimization, the compiled runnable plan and the actual tensor ops all happen inside the wasm module; this side only frames base64 ONNX bytes and JSON tensor descriptors. A model is compiled to a runnable plan at load time, so a malformed or unsupported-op ONNX file fails loudly at load, never on first inference; only f32 tensors are supported and anything else is refused explicitly, never coerced." ;
    bpm:engineOrdinal 4 ;
    bpm:wasmExportPrefix "tr" ;
    bpm:wasmArtifactPath "native/tract-wasm/target/wasm32-wasip1/release/tract_wasm.wasm" ;
    bpm:wasmBuildScript "scripts/tract_wasm_build.sh" ;
    bpm:dispatchSource "native/tract-wasm/src/lib.rs" ;
    bpm:healthId "tract_wasm" ;
    bpm:handleNoun "model" ;
    bpm:cheapTimeoutMs 30000 ;
    bpm:heavyTimeoutMs 60000 ;
    bpm:errorCollapse bpm:ErrorCollapse_single_key_inspect .

bap:engine_tract_op_load_model a bpm:EngineOp ;
    bpm:opEngine bap:engine_tract ; bpm:opName "load_model" ; bpm:opOrder 1 ;
    bpm:opDoc "`{\"op\":\"load_model\",\"model_b64\":...}` -- `model_bytes` is the raw ONNX protobuf (base64-encoded host-side; JSON strings cannot carry raw protobuf). Optimizes and compiles to a runnable plan immediately. `{:ok, %{\"handle\" => n, \"inputs\" => [%{\"name\" => s, \"shape\" => [dims|nil]}], \"outputs\" => [...]}}` -- a `nil` dim is a symbolic/dynamic axis tract could not fully resolve at load time, reported honestly rather than guessed." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_tract_op_load_model_bytes a bpm:EngineArg ;
    bpm:argOp bap:engine_tract_op_load_model ; bpm:argName "model_bytes" ; bpm:argOrder 1 ;
    bpm:argWireKey "model_b64" ; bpm:argType bpm:EngineArgType_binary ; bpm:argEncoding bpm:ArgEncoding_base64 .

bap:engine_tract_op_load_model_path a bpm:EngineOp ;
    bpm:opEngine bap:engine_tract ; bpm:opName "load_model_path" ; bpm:opOrder 2 ;
    bpm:opDoc "`File.read!/1` host-side, then `load_model/2` (raises if the path is absent)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_host_helper ;
    bpm:opDelegatesTo bap:engine_tract_op_load_model .
bap:engine_tract_op_load_model_path_path a bpm:EngineArg ;
    bpm:argOp bap:engine_tract_op_load_model_path ; bpm:argName "path" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_path .

bap:engine_tract_op_run a bpm:EngineOp ;
    bpm:opEngine bap:engine_tract ; bpm:opName "run" ; bpm:opOrder 3 ;
    bpm:opDoc "`{\"op\":\"run\",\"handle\":h,\"inputs\":[{\"shape\":[dims],\"data\":[f32,...]}]}` -- one f32 tensor per declared model input, in order (`inputs` a list of `%{shape: [dims], data: [floats]}`, converted to the wire's string-keyed shape here). `{:ok, %{\"outputs\" => [%{\"shape\" => [dims], \"data\" => [floats]}]}}`, one per declared model output, in order. Real tensor inference, even on a tiny model, draws the heavy timeout budget." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_tract_op_run_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_tract_op_run ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bap:engine_tract_op_run_inputs a bpm:EngineArg ;
    bpm:argOp bap:engine_tract_op_run ; bpm:argName "inputs" ; bpm:argOrder 2 ;
    bpm:argType bpm:EngineArgType_tensor_list ; bpm:argEncoding bpm:ArgEncoding_tensor_list .

bap:engine_tract_op_model_info a bpm:EngineOp ;
    bpm:opEngine bap:engine_tract ; bpm:opName "model_info" ; bpm:opOrder 4 ;
    bpm:opDoc "`{\"op\":\"model_info\",\"handle\":h}` -- same input/output fact shape as `load_model/2`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_tract_op_model_info_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_tract_op_model_info ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_tract_op_free_model a bpm:EngineOp ;
    bpm:opEngine bap:engine_tract ; bpm:opName "free_model" ; bpm:opOrder 5 ;
    bpm:opDoc "`{\"op\":\"free_model\",\"handle\":h}` -- releases the model handle; subsequent use errors with an unknown-handle message." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_tract_op_free_model_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_tract_op_free_model ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix bap: <https://ggen.dev/projects/beam4pm#> .

# -- rust4pm (native/rust4pm-wasm): process mining ----------------------------

bap:engine_rust4pm a bpm:Engine ;
    bpm:engineName "rust4pm" ;
    bpm:engineModule "Rust4PM" ;
    bpm:engineDoc "The ONE process-mining engine: rust4pm (`process_mining = \"=0.6.2\"`, native/rust4pm-wasm) -- XES import, variant projection, DFG discovery, alpha+++ and POWL discovery, PNML import, alignments, fitness, pm4py-ported stats ops and the documented OCEL 2.0 construction/discovery set, all computed inside the wasm module. `config`/`options` maps are passed to the engine VERBATIM (serde `AlphaPPPConfig` / `AlignmentOptions`); defaulting, validation and the UNSUPPORTED refusal of pm4py's discounted-A* cost keys all live engine-side, never emulated here." ;
    bpm:engineOrdinal 1 ;
    bpm:wasmExportPrefix "r4pm" ;
    bpm:wasmArtifactPath "native/rust4pm-wasm/target/wasm32-wasip1/release/rust4pm_wasm.wasm" ;
    bpm:wasmBuildScript "scripts/rust4pm_wasm_build.sh" ;
    bpm:dispatchSource "native/rust4pm-wasm/src/lib.rs" ;
    bpm:healthId "rust4pm_wasm" ;
    bpm:handleNoun "log/net/ocel" ;
    bpm:cheapTimeoutMs 30000 ;
    bpm:heavyTimeoutMs 120000 ;
    bpm:errorCollapse bpm:ErrorCollapse_any_key_raw .

bap:engine_rust4pm_op_import_xes a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "import_xes" ; bpm:opOrder 1 ;
    bpm:opDoc "`{\"op\":\"import_xes\",\"content\":...}` -- imports an entire XES document (UTF-8, passed by value) and returns `{:ok, %{\"handle\" => n}}`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_import_xes_content a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_import_xes ; bpm:argName "xes_content" ; bpm:argOrder 1 ;
    bpm:argWireKey "content" ; bpm:argType bpm:EngineArgType_string .

bap:engine_rust4pm_op_import_xes_path a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "import_xes_path" ; bpm:opOrder 2 ;
    bpm:opDoc "`File.read!/1` host-side, then `import_xes/2` (raises if the path is absent)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_host_helper ;
    bpm:opDelegatesTo bap:engine_rust4pm_op_import_xes .
bap:engine_rust4pm_op_import_xes_path_path a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_import_xes_path ; bpm:argName "path" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_path .

bap:engine_rust4pm_op_import_xes_gz a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "import_xes_gz" ; bpm:opOrder 3 ;
    bpm:opDoc "`{\"op\":\"import_xes_gz\",\"content_b64\":...}` -- gzip'd XES bytes, base64-encoded host-side (JSON strings cannot carry raw gzip bytes)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_import_xes_gz_bytes a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_import_xes_gz ; bpm:argName "gz_bytes" ; bpm:argOrder 1 ;
    bpm:argWireKey "content_b64" ; bpm:argType bpm:EngineArgType_binary ; bpm:argEncoding bpm:ArgEncoding_base64 .

bap:engine_rust4pm_op_import_pnml a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "import_pnml" ; bpm:opOrder 4 ;
    bpm:opDoc "`{\"op\":\"import_pnml\",\"content\":...}` -- imports a PNML document (UTF-8, by value) and returns `{:ok, %{\"net_handle\" => n, \"summary\" => %{...}}}`. A PNML without markings imports but later fails alignment with the engine's verbatim `NoInitialMarking`/`NoFinalMarking` error -- reported honestly in `summary[\"has_initial_marking\"]`/`summary[\"num_final_markings\"]`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_import_pnml_content a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_import_pnml ; bpm:argName "pnml_content" ; bpm:argOrder 1 ;
    bpm:argWireKey "content" ; bpm:argType bpm:EngineArgType_string .

bap:engine_rust4pm_op_import_pnml_path a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "import_pnml_path" ; bpm:opOrder 5 ;
    bpm:opDoc "`File.read!/1` host-side, then `import_pnml/2` (raises if the path is absent)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_host_helper ;
    bpm:opDelegatesTo bap:engine_rust4pm_op_import_pnml .
bap:engine_rust4pm_op_import_pnml_path_path a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_import_pnml_path ; bpm:argName "path" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_path .

bap:engine_rust4pm_op_log_stats a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "log_stats" ; bpm:opOrder 6 ;
    bpm:opDoc "`{\"op\":\"log_stats\",\"handle\":n}` -- `num_cases`/`num_variants`/`num_activities`/`activities` (sorted)/`top_variant`/`top_variant_count`. Field superset of the rf1 oracle wire (differential anchor)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_log_stats_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_log_stats ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_rust4pm_op_top_n_variants a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "top_n_variants" ; bpm:opOrder 7 ;
    bpm:opDoc "`{\"op\":\"top_n_variants\",\"handle\":n,\"n\":n}` -- descending-count variant list." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_top_n_variants_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_top_n_variants ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bap:engine_rust4pm_op_top_n_variants_n a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_top_n_variants ; bpm:argName "n" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_integer .

bap:engine_rust4pm_op_discover_dfg a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "discover_dfg" ; bpm:opOrder 8 ;
    bpm:opDoc "`{\"op\":\"discover_dfg\",\"handle\":n}` -- edges sorted by `(source, target)`, the identical sort to the rf1 oracle (element-for-element comparable)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_discover_dfg_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_discover_dfg ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_rust4pm_op_activities_to_alphabet a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "activities_to_alphabet" ; bpm:opOrder 9 ;
    bpm:opDoc "`{\"op\":\"activities_to_alphabet\",\"handle\":n}` -- pm4py `activities_to_alphabet` port: activities ranked by descending total event count (ties pinned to first-occurrence order in the log), mapped to bijective base-26 letters (`A..Z, AA, AB, ...`)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_activities_to_alphabet_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_activities_to_alphabet ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bap:engine_rust4pm_op_activity_position a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "activity_position" ; bpm:opOrder 10 ;
    bpm:opDoc "`{\"op\":\"activity_position\",\"handle\":n,\"activity\":a}` -- pm4py `get_activity_position_summary` port: histogram of the activity's 0-based within-trace indexes as ascending `[index, count]` pairs. Unknown activity returns empty positions, not an error." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_activity_position_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_activity_position ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bap:engine_rust4pm_op_activity_position_activity a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_activity_position ; bpm:argName "activity" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_string .

bap:engine_rust4pm_op_discover_alphappp a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "discover_alphappp" ; bpm:opOrder 11 ;
    bpm:opDoc "`{\"op\":\"discover_alphappp\",\"handle\":n[,\"config\":...]}` -- alpha+++ discovery. `config == nil` omits the key (engine uses `AlphaPPPConfig::default()`); a map is passed verbatim and must carry all 7 serde fields. Returns `{:ok, %{\"net_handle\" => n, \"summary\" => %{...}}}`; the discovered net always carries initial+final markings." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_discover_alphappp_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_discover_alphappp ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bap:engine_rust4pm_op_discover_alphappp_config a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_discover_alphappp ; bpm:argName "config" ; bpm:argOrder 2 ;
    bpm:argType bpm:EngineArgType_optional_map ; bpm:argMode bpm:ArgMode_optional ; bpm:argDefault "nil" ;
    bpm:argEncoding bpm:ArgEncoding_omit_when_nil .

bap:engine_rust4pm_op_discover_powl a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "discover_powl" ; bpm:opOrder 12 ;
    bpm:opDoc "`{\"op\":\"discover_powl\",\"handle\":n}` -- POWL discovery over an imported log (the crate's `discover_powl`, vendor/rust4pm-powl). Returns `{:ok, %{\"powl\" => model}}`, the crate's own serde shape. Previously a crate dispatch arm no facade exposed (UNEXPOSED_DISPATCH_ARM)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_discover_powl_handle a bpm:EngineArg ;
