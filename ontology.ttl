# ontology.ttl -- beam4pm project instance graph (admitted O* data)
#
# This file is beam4pm's OWN instance data, expressed using the bpm: vocabulary
# defined by the vendored ggen-marketplace pack "beam4pm-process-model-pack"
# (vendor/ggen-marketplace/packs/beam4pm-process-model-pack). The bpm:RecordType
# and bpm:Field classes/properties themselves live in that pack, not here --
# this file only contains individuals built from that vocabulary.
#
# Per beam4pm's source-authority doctrine
# (docs/jira/v26.8.29/03-architecture-and-ggen-manufacturing.md): this
# ontology.ttl and the beam4pm-process-model-pack's templates are legitimate
# human/LLM-authored manufacturing inputs. The Erlang and Elixir source under
# generated/ that they produce is NOT hand-authored -- it is ggen's
# manufactured output. Never hand-edit anything under generated/; edit this
# file or the pack's templates instead, then re-run `ggen sync run`.

@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# 1. ocel_event
# ---------------------------------------------------------------------------

bpm:ocel_event_rt a bpm:RecordType ;
    bpm:recordName "ocel_event" ;
    bpm:recordDoc "An OCEL 2.0 event: one recorded occurrence in an object-centric log." ;
    bpm:hasField bpm:ocel_event_event_id_f ,
                 bpm:ocel_event_event_type_f ,
                 bpm:ocel_event_event_time_f ,
                 bpm:ocel_event_attributes_f .

bpm:ocel_event_event_id_f a bpm:Field ;
    bpm:fieldName "event_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique event identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:ocel_event_event_type_f a bpm:Field ;
    bpm:fieldName "event_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The event's type/activity name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:ocel_event_event_time_f a bpm:Field ;
    bpm:fieldName "event_time" ;
    bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 timestamp the event occurred." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:ocel_event_attributes_f a bpm:Field ;
    bpm:fieldName "attributes" ;
    bpm:fieldType "map" ;
    bpm:fieldDoc "Arbitrary named event attributes." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 4 .

# ---------------------------------------------------------------------------
# 2. ocel_object
# ---------------------------------------------------------------------------

bpm:ocel_object_rt a bpm:RecordType ;
    bpm:recordName "ocel_object" ;
    bpm:recordDoc "An OCEL 2.0 object: one entity participating in the process." ;
    bpm:hasField bpm:ocel_object_object_id_f ,
                 bpm:ocel_object_object_type_f ,
                 bpm:ocel_object_attributes_f .

bpm:ocel_object_object_id_f a bpm:Field ;
    bpm:fieldName "object_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique object identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:ocel_object_object_type_f a bpm:Field ;
    bpm:fieldName "object_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The object's type." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:ocel_object_attributes_f a bpm:Field ;
    bpm:fieldName "attributes" ;
    bpm:fieldType "map" ;
    bpm:fieldDoc "Arbitrary named current attribute values (a flat snapshot, not the time-indexed history -- see bpm:ocel_attribute and bpm:object_attribute_change for per-timestamp values)." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

# ---------------------------------------------------------------------------
# 3. ocel_relationship
# ---------------------------------------------------------------------------

bpm:ocel_relationship_rt a bpm:RecordType ;
    bpm:recordName "ocel_relationship" ;
    bpm:recordDoc "A qualified relationship linking an event or object to an object." ;
    bpm:hasField bpm:ocel_relationship_qualifier_f ,
                 bpm:ocel_relationship_object_id_f .

bpm:ocel_relationship_qualifier_f a bpm:Field ;
    bpm:fieldName "qualifier" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The relationship qualifier/role name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:ocel_relationship_object_id_f a bpm:Field ;
    bpm:fieldName "object_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The related object's identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

# ---------------------------------------------------------------------------
# 4. dfg_edge
# ---------------------------------------------------------------------------

bpm:dfg_edge_rt a bpm:RecordType ;
    bpm:recordName "dfg_edge" ;
    bpm:recordDoc "One frequency-annotated directly-follows edge between two activities." ;
    bpm:hasField bpm:dfg_edge_source_activity_f ,
                 bpm:dfg_edge_target_activity_f ,
                 bpm:dfg_edge_frequency_f .

bpm:dfg_edge_source_activity_f a bpm:Field ;
    bpm:fieldName "source_activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The preceding activity name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:dfg_edge_target_activity_f a bpm:Field ;
    bpm:fieldName "target_activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The following activity name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:dfg_edge_frequency_f a bpm:Field ;
    bpm:fieldName "frequency" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Observed occurrence count of this edge." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

# ---------------------------------------------------------------------------
# 5. petri_place
# ---------------------------------------------------------------------------

bpm:petri_place_rt a bpm:RecordType ;
    bpm:recordName "petri_place" ;
    bpm:recordDoc "A place in a Petri net, holding a non-negative token count." ;
    bpm:hasField bpm:petri_place_place_id_f ,
                 bpm:petri_place_tokens_f .

bpm:petri_place_place_id_f a bpm:Field ;
    bpm:fieldName "place_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique place identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:petri_place_tokens_f a bpm:Field ;
    bpm:fieldName "tokens" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Current token count (marking) at this place." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

# ---------------------------------------------------------------------------
# 6. petri_transition
# ---------------------------------------------------------------------------

bpm:petri_transition_rt a bpm:RecordType ;
    bpm:recordName "petri_transition" ;
    bpm:recordDoc "A transition in a Petri net." ;
    bpm:hasField bpm:petri_transition_transition_id_f ,
                 bpm:petri_transition_label_f .

bpm:petri_transition_transition_id_f a bpm:Field ;
    bpm:fieldName "transition_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique transition identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:petri_transition_label_f a bpm:Field ;
    bpm:fieldName "label" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Optional human-readable/activity label (silent transition if absent)." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 2 .

# ---------------------------------------------------------------------------
# 7. petri_arc
# ---------------------------------------------------------------------------

bpm:petri_arc_rt a bpm:RecordType ;
    bpm:recordName "petri_arc" ;
    bpm:recordDoc "A weighted arc connecting a place and a transition (either direction)." ;
    bpm:hasField bpm:petri_arc_source_id_f ,
                 bpm:petri_arc_target_id_f ,
                 bpm:petri_arc_weight_f .

bpm:petri_arc_source_id_f a bpm:Field ;
    bpm:fieldName "source_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the arc's source node." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:petri_arc_target_id_f a bpm:Field ;
    bpm:fieldName "target_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the arc's target node." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:petri_arc_weight_f a bpm:Field ;
    bpm:fieldName "weight" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Arc weight (tokens consumed/produced per firing)." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

# ---------------------------------------------------------------------------
# 8. alignment_move
# ---------------------------------------------------------------------------

bpm:alignment_move_rt a bpm:RecordType ;
    bpm:recordName "alignment_move" ;
    bpm:recordDoc "One step of a conformance-checking alignment between log and model." ;
    bpm:hasField bpm:alignment_move_move_type_f ,
                 bpm:alignment_move_cost_f .

bpm:alignment_move_move_type_f a bpm:Field ;
    bpm:fieldName "move_type" ;
    bpm:fieldType "atom" ;
    bpm:fieldDoc "One of: sync | model | log | silent." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:alignment_move_cost_f a bpm:Field ;
    bpm:fieldName "cost" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Non-negative cost assigned to this move." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

# ---------------------------------------------------------------------------
# Swarm-manufactured extension (2026-08-29): 23 additional admitted record
# types drawn from the process-mining concept worklist in
# docs/jira/v26.8.29/14-rust4pm-reference-boundary.md, plus adjacent runtime/
# planning/policy concepts named in the same doctrine package.
# ---------------------------------------------------------------------------

bpm:case_stats_rt a bpm:RecordType ;
    bpm:recordName "case_stats" ;
    bpm:recordDoc "Aggregate statistics computed for one process instance (case)." ;
    bpm:hasField bpm:case_stats_case_id_f , bpm:case_stats_event_count_f , bpm:case_stats_duration_seconds_f .

bpm:case_stats_case_id_f a bpm:Field ;
    bpm:fieldName "case_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique case identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:case_stats_event_count_f a bpm:Field ;
    bpm:fieldName "event_count" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Number of events observed for this case." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:case_stats_duration_seconds_f a bpm:Field ;
    bpm:fieldName "duration_seconds" ;
    bpm:fieldType "float" ;
    bpm:fieldDoc "Optional case duration in seconds (end minus start)." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:event_log_rt a bpm:RecordType ;
    bpm:recordName "event_log" ;
    bpm:recordDoc "A named collection of events forming one process-mining log." ;
    bpm:hasField bpm:event_log_log_id_f , bpm:event_log_name_f , bpm:event_log_description_f .

bpm:event_log_log_id_f a bpm:Field ;
    bpm:fieldName "log_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique log identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:event_log_name_f a bpm:Field ;
    bpm:fieldName "name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Human-readable log name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:event_log_description_f a bpm:Field ;
    bpm:fieldName "description" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Optional free-text description of this log." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:ocel_attribute_rt a bpm:RecordType ;
    bpm:recordName "ocel_attribute" ;
    bpm:recordDoc "One named, timestamped attribute value on an OCEL event or object." ;
    bpm:hasField bpm:ocel_attribute_attribute_name_f , bpm:ocel_attribute_attribute_value_f , bpm:ocel_attribute_recorded_at_f .

bpm:ocel_attribute_attribute_name_f a bpm:Field ;
    bpm:fieldName "attribute_name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The attribute name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:ocel_attribute_attribute_value_f a bpm:Field ;
    bpm:fieldName "attribute_value" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The attribute value, serialized as a string." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:ocel_attribute_recorded_at_f a bpm:Field ;
    bpm:fieldName "recorded_at" ;
    bpm:fieldType "datetime" ;
    bpm:fieldDoc "Optional ISO8601 timestamp this value was recorded/became effective." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:type_edge_rt a bpm:RecordType ;
    bpm:recordName "type_edge" ;
    bpm:recordDoc "A directed, qualified edge in the OCEL type graph between two types." ;
    bpm:hasField bpm:type_edge_source_type_f , bpm:type_edge_target_type_f , bpm:type_edge_qualifier_f , bpm:type_edge_direction_f .

bpm:type_edge_source_type_f a bpm:Field ;
    bpm:fieldName "source_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The edge source type name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:type_edge_target_type_f a bpm:Field ;
    bpm:fieldName "target_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The edge target type name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:type_edge_qualifier_f a bpm:Field ;
    bpm:fieldName "qualifier" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The relationship qualifier/role name for this edge." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:type_edge_direction_f a bpm:Field ;
    bpm:fieldName "direction" ;
    bpm:fieldType "atom" ;
    bpm:fieldDoc "One of: e2o | o2o." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 4 .

bpm:event_type_rt a bpm:RecordType ;
    bpm:recordName "event_type" ;
    bpm:recordDoc "A declared OCEL event type and its attribute schema." ;
    bpm:hasField bpm:event_type_type_name_f , bpm:event_type_attribute_names_f .

bpm:event_type_type_name_f a bpm:Field ;
    bpm:fieldName "type_name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The event type name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:event_type_attribute_names_f a bpm:Field ;
    bpm:fieldName "attribute_names" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "Optional declared attribute names for events of this type (name-only; per-attribute value types are not yet modeled)." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 2 .

bpm:object_attribute_change_rt a bpm:RecordType ;
    bpm:recordName "object_attribute_change" ;
    bpm:recordDoc "One recorded change to a time-indexed object attribute." ;
    bpm:hasField bpm:object_attribute_change_object_id_f , bpm:object_attribute_change_attribute_name_f , bpm:object_attribute_change_old_value_f , bpm:object_attribute_change_new_value_f , bpm:object_attribute_change_changed_at_f .

bpm:object_attribute_change_object_id_f a bpm:Field ;
    bpm:fieldName "object_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the object whose attribute changed." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:object_attribute_change_attribute_name_f a bpm:Field ;
    bpm:fieldName "attribute_name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The changed attribute name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:object_attribute_change_old_value_f a bpm:Field ;
    bpm:fieldName "old_value" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Optional previous value (absent if this is the first recorded value)." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:object_attribute_change_new_value_f a bpm:Field ;
    bpm:fieldName "new_value" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The new value after the change." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 4 .

bpm:object_attribute_change_changed_at_f a bpm:Field ;
    bpm:fieldName "changed_at" ;
    bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 timestamp the change took effect." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 5 .

bpm:sojourn_time_rt a bpm:RecordType ;
    bpm:recordName "sojourn_time" ;
    bpm:recordDoc "The total dwell/duration time an object was associated with one event/activity (object-centric sojourn time -- a duration metric, distinct from bpm:sync_time's wait-for-another-object metric)." ;
    bpm:hasField bpm:sojourn_time_object_id_f , bpm:sojourn_time_event_type_f , bpm:sojourn_time_seconds_f .

bpm:sojourn_time_object_id_f a bpm:Field ;
    bpm:fieldName "object_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the object this measurement is for." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:sojourn_time_event_type_f a bpm:Field ;
    bpm:fieldName "event_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The event type/activity this sojourn measurement is at." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:sojourn_time_seconds_f a bpm:Field ;
    bpm:fieldName "seconds" ;
    bpm:fieldType "float" ;
    bpm:fieldDoc "Sojourn duration in seconds." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:process_variant_rt a bpm:RecordType ;
    bpm:recordName "process_variant" ;
    bpm:recordDoc "One distinct activity-sequence variant observed in a log, with its frequency." ;
    bpm:hasField bpm:process_variant_variant_id_f , bpm:process_variant_activity_sequence_f , bpm:process_variant_frequency_f .

bpm:process_variant_variant_id_f a bpm:Field ;
    bpm:fieldName "variant_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique variant identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:process_variant_activity_sequence_f a bpm:Field ;
    bpm:fieldName "activity_sequence" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "Ordered list of activity names making up this variant." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:process_variant_frequency_f a bpm:Field ;
    bpm:fieldName "frequency" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Number of traces observed with exactly this activity sequence." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:conformance_result_rt a bpm:RecordType ;
    bpm:recordName "conformance_result" ;
    bpm:recordDoc "Conformance-checking metrics computed for one trace against a model." ;
    bpm:hasField bpm:conformance_result_trace_id_f , bpm:conformance_result_fitness_f , bpm:conformance_result_precision_f .

bpm:conformance_result_trace_id_f a bpm:Field ;
    bpm:fieldName "trace_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the trace this result was computed for." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:conformance_result_fitness_f a bpm:Field ;
    bpm:fieldName "fitness" ;
    bpm:fieldType "float" ;
    bpm:fieldDoc "Fitness score in [0.0, 1.0]." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:conformance_result_precision_f a bpm:Field ;
    bpm:fieldName "precision" ;
    bpm:fieldType "float" ;
    bpm:fieldDoc "Optional precision score in [0.0, 1.0]." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:heuristic_arc_rt a bpm:RecordType ;
    bpm:recordName "heuristic_arc" ;
    bpm:recordDoc "One dependency-scored candidate arc considered during heuristic-net discovery." ;
    bpm:hasField bpm:heuristic_arc_source_activity_f , bpm:heuristic_arc_target_activity_f , bpm:heuristic_arc_dependency_measure_f .

bpm:heuristic_arc_source_activity_f a bpm:Field ;
    bpm:fieldName "source_activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The candidate arc source activity." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:heuristic_arc_target_activity_f a bpm:Field ;
    bpm:fieldName "target_activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The candidate arc target activity." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:heuristic_arc_dependency_measure_f a bpm:Field ;
    bpm:fieldName "dependency_measure" ;
    bpm:fieldType "float" ;
    bpm:fieldDoc "The computed dependency/confidence score for this candidate arc." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:oc_declare_constraint_rt a bpm:RecordType ;
    bpm:recordName "oc_declare_constraint" ;
    bpm:recordDoc "One declarative object-centric behavioral constraint between two activities." ;
    bpm:hasField bpm:oc_declare_constraint_constraint_id_f , bpm:oc_declare_constraint_source_activity_f , bpm:oc_declare_constraint_target_activity_f , bpm:oc_declare_constraint_constraint_type_f .

bpm:oc_declare_constraint_constraint_id_f a bpm:Field ;
    bpm:fieldName "constraint_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique constraint identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:oc_declare_constraint_source_activity_f a bpm:Field ;
    bpm:fieldName "source_activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The constraint source activity." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:oc_declare_constraint_target_activity_f a bpm:Field ;
    bpm:fieldName "target_activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The constraint target activity." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:oc_declare_constraint_constraint_type_f a bpm:Field ;
    bpm:fieldName "constraint_type" ;
    bpm:fieldType "atom" ;
    bpm:fieldDoc "One of: response | precedence | succession | non_coexistence (standard DECLARE constraint template names)." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 4 .

bpm:path_schema_rt a bpm:RecordType ;
    bpm:recordName "path_schema" ;
    bpm:recordDoc "One reusable, scored connection pattern between two OCEL types." ;
    bpm:hasField bpm:path_schema_schema_id_f , bpm:path_schema_source_type_f , bpm:path_schema_target_type_f , bpm:path_schema_support_f .

bpm:path_schema_schema_id_f a bpm:Field ;
    bpm:fieldName "schema_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique path schema identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:path_schema_source_type_f a bpm:Field ;
    bpm:fieldName "source_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The source event/object type name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:path_schema_target_type_f a bpm:Field ;
    bpm:fieldName "target_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The target event/object type name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:path_schema_support_f a bpm:Field ;
    bpm:fieldName "support" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Observed instance count supporting this schema." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 4 .

bpm:resource_allocation_rt a bpm:RecordType ;
    bpm:recordName "resource_allocation" ;
    bpm:recordDoc "One recorded assignment of a resource to an activity occurrence." ;
    bpm:hasField bpm:resource_allocation_resource_id_f , bpm:resource_allocation_activity_f , bpm:resource_allocation_event_id_f .

bpm:resource_allocation_resource_id_f a bpm:Field ;
    bpm:fieldName "resource_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the assigned resource." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:resource_allocation_activity_f a bpm:Field ;
    bpm:fieldName "activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The activity the resource was assigned to." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:resource_allocation_event_id_f a bpm:Field ;
    bpm:fieldName "event_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the specific event occurrence." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:log_trace_rt a bpm:RecordType ;
    bpm:recordName "log_trace" ;
    bpm:recordDoc "One case-centric trace: an ordered activity sequence for a single case." ;
    bpm:hasField bpm:log_trace_case_id_f , bpm:log_trace_activity_sequence_f .

bpm:log_trace_case_id_f a bpm:Field ;
    bpm:fieldName "case_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the case this trace belongs to." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:log_trace_activity_sequence_f a bpm:Field ;
    bpm:fieldName "activity_sequence" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "Ordered list of activity names observed for this case." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:queue_snapshot_rt a bpm:RecordType ;
    bpm:recordName "queue_snapshot" ;
    bpm:recordDoc "One point-in-time observation of a queue depth." ;
    bpm:hasField bpm:queue_snapshot_queue_name_f , bpm:queue_snapshot_depth_f , bpm:queue_snapshot_observed_at_f .

bpm:queue_snapshot_queue_name_f a bpm:Field ;
    bpm:fieldName "queue_name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Name of the observed queue." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:queue_snapshot_depth_f a bpm:Field ;
    bpm:fieldName "depth" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Observed queue depth at this point in time." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:queue_snapshot_observed_at_f a bpm:Field ;
    bpm:fieldName "observed_at" ;
    bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 timestamp of this observation." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:sync_time_rt a bpm:RecordType ;
    bpm:recordName "sync_time" ;
    bpm:recordDoc "The time one object waited to synchronize with another object at a shared event." ;
    bpm:hasField bpm:sync_time_object_id_f , bpm:sync_time_delaying_object_id_f , bpm:sync_time_seconds_f .

bpm:sync_time_object_id_f a bpm:Field ;
    bpm:fieldName "object_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the object this measurement is for." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:sync_time_delaying_object_id_f a bpm:Field ;
    bpm:fieldName "delaying_object_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Optional identifier of the object that caused the delay." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 2 .

bpm:sync_time_seconds_f a bpm:Field ;
    bpm:fieldName "seconds" ;
    bpm:fieldType "float" ;
    bpm:fieldDoc "Synchronization wait duration in seconds." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:object_type_rt a bpm:RecordType ;
    bpm:recordName "object_type" ;
    bpm:recordDoc "A declared OCEL object type and its attribute schema." ;
    bpm:hasField bpm:object_type_type_name_f , bpm:object_type_attribute_names_f .

bpm:object_type_type_name_f a bpm:Field ;
    bpm:fieldName "type_name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The object type name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:object_type_attribute_names_f a bpm:Field ;
    bpm:fieldName "attribute_names" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "Optional declared attribute names for objects of this type (name-only; per-attribute value types are not yet modeled)." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 2 .

bpm:planning_action_rt a bpm:RecordType ;
    bpm:recordName "planning_action" ;
    bpm:recordDoc "One PDDL-style planning action with its preconditions and effects." ;
    bpm:hasField bpm:planning_action_action_name_f , bpm:planning_action_preconditions_f , bpm:planning_action_effects_f .

bpm:planning_action_action_name_f a bpm:Field ;
    bpm:fieldName "action_name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The action name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:planning_action_preconditions_f a bpm:Field ;
    bpm:fieldName "preconditions" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "Optional list of precondition fact names." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 2 .

bpm:planning_action_effects_f a bpm:Field ;
    bpm:fieldName "effects" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "Optional list of effect fact names this action produces." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:path_schema_query_rt a bpm:RecordType ;
    bpm:recordName "path_schema_query" ;
    bpm:recordDoc "A discovery query bounding source/target types and maximum schema length." ;
    bpm:hasField bpm:path_schema_query_source_type_f , bpm:path_schema_query_target_type_f , bpm:path_schema_query_max_length_f .

bpm:path_schema_query_source_type_f a bpm:Field ;
    bpm:fieldName "source_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The query source type name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:path_schema_query_target_type_f a bpm:Field ;
    bpm:fieldName "target_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The query target type name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:path_schema_query_max_length_f a bpm:Field ;
    bpm:fieldName "max_length" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Maximum number of hops to search." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:policy_decision_rt a bpm:RecordType ;
    bpm:recordName "policy_decision" ;
    bpm:recordDoc "One admission/authority policy decision recorded for an attempted action." ;
    bpm:hasField bpm:policy_decision_decision_id_f , bpm:policy_decision_verdict_f , bpm:policy_decision_reason_f .

bpm:policy_decision_decision_id_f a bpm:Field ;
    bpm:fieldName "decision_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique decision identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:policy_decision_verdict_f a bpm:Field ;
    bpm:fieldName "verdict" ;
    bpm:fieldType "atom" ;
    bpm:fieldDoc "One of: admitted | refused | blocked." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:policy_decision_reason_f a bpm:Field ;
    bpm:fieldName "reason" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Optional human-readable reason for this verdict." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:planning_state_rt a bpm:RecordType ;
    bpm:recordName "planning_state" ;
    bpm:recordDoc "One planning-search state as a bounded set of true facts." ;
    bpm:hasField bpm:planning_state_state_id_f , bpm:planning_state_facts_f .

bpm:planning_state_state_id_f a bpm:Field ;
    bpm:fieldName "state_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique state identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:planning_state_facts_f a bpm:Field ;
    bpm:fieldName "facts" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "List of fact names true in this state." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:k8s_object_ref_rt a bpm:RecordType ;
    bpm:recordName "k8s_object_ref" ;
    bpm:recordDoc "A reference to one Kubernetes object observed in the runtime topology." ;
    bpm:hasField bpm:k8s_object_ref_kind_f , bpm:k8s_object_ref_name_f , bpm:k8s_object_ref_namespace_f .

bpm:k8s_object_ref_kind_f a bpm:Field ;
    bpm:fieldName "kind" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The Kubernetes object kind (e.g. Pod, Deployment)." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:k8s_object_ref_name_f a bpm:Field ;
    bpm:fieldName "name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The object name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:k8s_object_ref_namespace_f a bpm:Field ;
    bpm:fieldName "namespace" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Optional object namespace (absent for cluster-scoped kinds such as Node, PersistentVolume, ClusterRole, or Namespace itself)." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:service_span_rt a bpm:RecordType ;
    bpm:recordName "service_span" ;
    bpm:recordDoc "One OpenTelemetry-style tracing span observed for a service call." ;
    bpm:hasField bpm:service_span_span_id_f , bpm:service_span_service_name_f , bpm:service_span_duration_ms_f , bpm:service_span_parent_span_id_f .

bpm:service_span_span_id_f a bpm:Field ;
    bpm:fieldName "span_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique span identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:service_span_service_name_f a bpm:Field ;
    bpm:fieldName "service_name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Name of the service that produced this span." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:service_span_duration_ms_f a bpm:Field ;
    bpm:fieldName "duration_ms" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Span duration in milliseconds." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:service_span_parent_span_id_f a bpm:Field ;
    bpm:fieldName "parent_span_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Optional identifier of the parent span." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 4 .

# =============================================================================
# beam4pm_pro infrastructure instance data (beam4pm-pro-infra-pack)
# =============================================================================
@prefix b4p:  <https://ggen.dev/projects/beam4pm-pro#> .
@prefix b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#> .

b4p:beam4pm_pro_cloudrun a b4pi:Deployment ;
    b4pi:serviceName          "beam4pm-pro" ;
    b4pi:region               "us-central1" ;
    b4pi:containerImage       "ghcr.io/seanchatmangpt/beam4pm:latest" ;
    b4pi:cpuLimit             "1" ;
    b4pi:memoryLimit          "512Mi" ;
    b4pi:minInstances         0 ;
    b4pi:maxInstances         3 ;
    b4pi:port                 8080 ;
    b4pi:allowUnauthenticated false ;
    b4pi:purpose              "beam4pm_pro commercial service surface: the published beam4pm container (ghcr.io/seanchatmangpt/beam4pm) run as a scale-to-zero Cloud Run v2 service with demo-grade resource bounds." .

@prefix b4pp: <http://seanchatmangpt.github.io/beam4pm-pro#> .

b4pp:proVmImage
    a b4pi:PackerImage ;
    b4pi:imageName "beam4pm-pro" ;
    b4pi:imageFamily "beam4pm-pro" ;
    b4pi:imageDescription "beam4pm_pro VM image: Debian 12 + Docker + pre-pulled beam4pm container under systemd" ;
    b4pi:gcpProjectDefault "beam4pm-pro-demo" ;
    b4pi:buildZone "us-central1-a" ;
    b4pi:buildMachineType "e2-medium" ;
    b4pi:buildDiskGb 20 ;
    b4pi:sourceImageFamily "debian-12" ;
    b4pi:sourceImageProject "debian-cloud" ;
    b4pi:sshUsername "packer" ;
    b4pi:packerContainerImage "ghcr.io/seanchatmangpt/beam4pm:latest" ;
    b4pi:containerName "beam4pm" ;
    b4pi:servicePort 8080 ;
    b4pi:serviceDescription "beam4pm_pro BEAM process-mining service (containerized)" ;
    b4pi:networkTag "beam4pm-pro" ;
    b4pi:networkTag "packer-build" .

# =============================================================================
# beam4pm BRCE actuation admission graph (SELECT layer, gate PI7/PI8)
# =============================================================================
@prefix bpma: <https://ggen.dev/ontology/beam4pm-actuation#> .

bpma:increment_counter_aa a bpma:AdmittedActuation ;
    bpma:actionName "increment_counter" ;
    bpma:gymOp "inc" ;
    bpma:requiresFact "counter_ready" .

bpma:observe_counter_aa a bpma:AdmittedActuation ;
    bpma:actionName "observe_counter" ;
    bpma:gymOp "noop" .

# =============================================================================
# GitHub Actions CI + GHCR container-publish workflow instance data
# =============================================================================
# ---------------------------------------------------------------------------
# GitHub Actions manufacturing facts (github-actions-pack vocabulary).
#
# APPEND this fragment to beam4pm's ontology.ttl. It declares beam4pm's OWN
# gha:Workflow/gha:Job/gha:Step individuals against the schema-only
# vendor/ggen-marketplace/packs/github-actions-pack vocabulary, exactly the
# way ggen-ecosystem's ontology.ttl does for its two workflows. The rendered
# .github/workflows/beam4pm-ci.yml and .github/workflows/beam4pm-container.yml
# are MANUFACTURED consequences of these facts (via the pack's
# templates/workflow.yml.tmpl) -- never hand-edit the rendered YAML; edit
# these facts and re-run `ggen sync run`.
#
# beam4pm-ci.yml REPLACES the previously hand-authored .github/workflows/ci.yml
# (same OTP 27.2 / rebar3 3.24.0 choices, same steps including the
# honestly-gapped determinism check, plus: gleam test over the Gleam
# projection, workflow_dispatch, and every third-party action pinned to a
# 40-hex commit SHA as the pack's gate 020 requires). Delete ci.yml in the
# same change that lands the manufactured replacement.
#
# ELIXIR BUMP 1.17.3 -> 1.18.5, measured not assumed: the current
# beam4pm's Elixir code calls Elixir's built-in JSON module (JSON.encode!/1,
# new in Elixir 1.18), and mix.exs's ex_ast transitive dep requires ~> 1.18.
# A real containerized `mix test` on 1.17.3 (2026-08-29) failed 34/248 tests
# with UndefinedFunctionError on JSON.encode!/1; the same suite passes 248/248
# on >= 1.18. So the hand-authored ci.yml's 1.17.3 pin is already broken
# against beam4pm's own current code -- this is the "conflict" case where the
# old version choice must not be kept. v1.18.5-otp-27 confirmed present in
# https://builds.hex.pm/builds/elixir/builds.txt (published 2026-08-28), the
# exact list erlef/setup-beam installs from.
#
# Action pins resolved for real on 2026-08-29 (not assumed):
#   - actions/checkout d23441a4... / docker/login-action 74a5d142... /
#     docker/setup-buildx-action 8d2750c6... / docker/build-push-action
#     10e90e36... reuse the exact SHAs already verified and in production in
#     ggen-ecosystem's ontology.ttl.
#   - erlef/setup-beam v1.24.1 resolved via `git ls-remote --tags
#     https://github.com/erlef/setup-beam.git` -> 54075bcc5e249e4758d363f27d099f55d843f124
#     (lightweight tag, so the tag SHA is the commit SHA), and its real
#     action.yml at that exact SHA was fetched and confirmed to declare the
#     `gleam-version` input used below -- that is the clean, single-action
#     install path for Gleam 1.18.1 on the runner.
# ---------------------------------------------------------------------------

@prefix gha: <http://seanchatmangpt.github.io/packs/github-actions#> .
@prefix bex: <https://ggen.dev/beam4pm/github-sync#> .

# --- Workflow 1: CI (manufactured replacement for the hand-authored ci.yml) --

bex:ciWorkflow
    a gha:Workflow ;
    gha:fileName "beam4pm-ci.yml" ;
    gha:purpose "beam4pm CI" ;
    gha:permissionCeiling "contents: read" ;
    gha:trigger gha:EventPush ;
    gha:trigger gha:EventPullRequest ;
    gha:trigger gha:EventWorkflowDispatch ;
    gha:onBlock """push:
  branches: [main]
pull_request:
  branches: [main]
workflow_dispatch:""" ;
    gha:evidenceObligation "green rebar3 eunit, mix test, and gleam test runs against the exact candidate SHA, plus the (currently continue-on-error) GATE M2 determinism check (scripts/gate_m2_check.sh)" ;
    gha:standingEffect "a green run confers test-passing standing on the exact candidate SHA for the Erlang, Elixir, and Gleam projections; it does not confer determinism standing until the ggen-install gap in the final step is closed" .

bex:ciTest
    a gha:Job ;
    gha:inWorkflow bex:ciWorkflow ;
    gha:jobName "test" ;
    gha:runner "ubuntu-latest" ;
    gha:timeoutMinutes 30 ;
    gha:jobPermissions "contents: read" ;
    gha:jobExtra "name: Erlang/Elixir/Gleam tests + determinism check" ;
    gha:evidenceEmitted "eunit, mix test, and gleam test results in the run log" ;
    gha:failureClassification "BUILD_BROKEN for a compile failure; a red test suite is a production defect in the manufactured projections or their semantic inputs" .

bex:ciCheckout
    a gha:Step ;
    gha:inJob bex:ciTest ; gha:stepOrder 1 ;
    gha:stepName "Checkout (with vendor/ggen-marketplace submodule)" ;
    gha:usesAction "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6" ;
    gha:withParam "submodules: recursive" ;
    gha:withParam "persist-credentials: false" .

bex:ciSetupBeam
    a gha:Step ;
    gha:inJob bex:ciTest ; gha:stepOrder 2 ;
    gha:stepName "Set up Erlang/OTP + Elixir + rebar3 + Gleam" ;
    gha:usesAction "erlef/setup-beam@54075bcc5e249e4758d363f27d099f55d843f124 # v1.24.1" ;
    gha:withParam "otp-version: '27.2'" ;
    gha:withParam "elixir-version: '1.18.5'" ;
    gha:withParam "rebar3-version: '3.24.0'" ;
    gha:withParam "gleam-version: '1.18.1'" .

bex:ciRebar3Eunit
    a gha:Step ;
    gha:inJob bex:ciTest ; gha:stepOrder 3 ;
    gha:stepName "rebar3 eunit" ;
    gha:runCommand "rebar3 eunit" .

bex:ciMixDepsGet
    a gha:Step ;
    gha:inJob bex:ciTest ; gha:stepOrder 4 ;
    gha:stepName "mix deps.get" ;
    gha:runCommand "mix deps.get" .

bex:ciMixTest
    a gha:Step ;
    gha:inJob bex:ciTest ; gha:stepOrder 5 ;
    gha:stepName "mix test" ;
    gha:runCommand "mix test" .

bex:ciGleamTest
    a gha:Step ;
    gha:inJob bex:ciTest ; gha:stepOrder 6 ;
    gha:stepName "gleam test (gleam/ projection)" ;
    gha:runCommand """cd gleam
gleam test""" .

# Determinism check carried over verbatim-in-spirit from the hand-authored
# ci.yml, including its honestly-declared gap: no real `ggen` install step is
# wired yet, so the step stays continue-on-error until one is added. The gap
# is documented (not faked into a pass) exactly as before.
bex:ciDeterminism
    a gha:Step ;
    gha:inJob bex:ciTest ; gha:stepOrder 7 ;
    gha:stepName "Determinism check -- regenerate and diff against committed output" ;
    gha:continueOnError true ;
    gha:runCommand """# KNOWN GAP (carried from the replaced hand-authored ci.yml, still open):
# this step needs a real `ggen` binary on the runner and none is installed
# here yet. It fails loudly ('ggen: command not found') instead of faking a
# pass; continue-on-error is set only so this one tracked gap does not turn
# every push/PR red. Remove continue-on-error once a real install step lands.
bash scripts/gate_m2_check.sh""" .

# --- Workflow 2: GHCR container build + publish ------------------------------
# Mirrors ggen-ecosystem's container workflow structure (checkout-with-
# submodules -> buildx -> GHCR login with the ephemeral GITHUB_TOKEN ->
# build-push-action with type=gha layer cache + SBOM/provenance), collapsed to
# a single native-arch job: beam4pm's image is a BEAM build measured in
# seconds, not ggen-ecosystem's QEMU-hostile Rust LTO workspace that forced
# its two-native-jobs + manifest-merge split.

bex:containerWorkflow
    a gha:Workflow ;
    gha:fileName "beam4pm-container.yml" ;
    gha:purpose "beam4pm Container Build & Publish" ;
    gha:permissionCeiling "contents: read" ;
    gha:trigger gha:EventPush ;
    gha:trigger gha:EventWorkflowDispatch ;
    gha:onBlock """push:
  branches: [main]
workflow_dispatch:""" ;
    gha:requiredSecret "GITHUB_TOKEN" ;
    gha:secretReason "GHCR login (docker/login-action) to push the beam4pm image; the workflow's own ephemeral token under the job's packages:write grant, no PAT" ;
    gha:evidenceObligation "bind the exact candidate SHA to the published image digest under tags latest and sha-<sha>" ;
    gha:standingEffect "a pushed image is evidence only for the exact commit and Dockerfile content that produced it; publish is distribution, not test standing" .

bex:containerBuildPush
    a gha:Job ;
    gha:inWorkflow bex:containerWorkflow ;
    gha:jobName "build-and-push" ;
    gha:runner "ubuntu-latest" ;
    gha:timeoutMinutes 30 ;
    gha:jobPermissions """contents: read
packages: write""" ;
    gha:jobExtra "name: Build and push beam4pm image to GHCR" ;
    gha:evidenceEmitted "published ghcr.io/<repository> image digest under tags latest and sha-${{ github.sha }}" ;
    gha:failureClassification "BUILD_BROKEN if the image build or its in-build rebar3 eunit / mix test gates fail" .

bex:containerCheckout
    a gha:Step ;
    gha:inJob bex:containerBuildPush ; gha:stepOrder 1 ;
    gha:stepName "Checkout with submodules" ;
    gha:usesAction "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6" ;
    gha:withParam "submodules: recursive" ;
    gha:withParam "persist-credentials: false" .

bex:containerBuildx
    a gha:Step ;
    gha:inJob bex:containerBuildPush ; gha:stepOrder 2 ;
    gha:stepName "Set up Docker Buildx" ;
    gha:usesAction "docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3" .

bex:containerLogin
    a gha:Step ;
    gha:inJob bex:containerBuildPush ; gha:stepOrder 3 ;
    gha:stepName "Log in to GHCR" ;
    gha:usesAction "docker/login-action@74a5d142397b4f367a81961eba4e8cd7edddf772 # v3" ;
    gha:withParam "registry: ghcr.io" ;
    gha:withParam "username: ${{ github.actor }}" ;
    gha:withParam "password: ${{ secrets.GITHUB_TOKEN }}" .

bex:containerBuildPushStep
    a gha:Step ;
    gha:inJob bex:containerBuildPush ; gha:stepOrder 4 ;
    gha:stepName "Build and push beam4pm image" ;
    gha:usesAction "docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6" ;
    gha:withParam "context: ." ;
    gha:withParam "push: true" ;
    gha:withParam "sbom: true" ;
    gha:withParam "provenance: true" ;
    gha:withParam "cache-from: type=gha,scope=beam4pm" ;
    gha:withParam "cache-to: type=gha,mode=max,scope=beam4pm" ;
    gha:withParam "tags: ghcr.io/${{ github.repository }}:latest,ghcr.io/${{ github.repository }}:sha-${{ github.sha }}" .

# =============================================================================
# beam4pm-ai-contracts-pack instance data (P0-A: canonical AI/evidence contracts)
# =============================================================================
@prefix aic: <https://ggen.dev/ontology/beam4pm-ai#> .
@prefix bap: <https://ggen.dev/projects/beam4pm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# 1. evidence_envelope
# ---------------------------------------------------------------------------

bap:evidence_envelope_ct a aic:ContractType ;
    aic:contractName "evidence_envelope" ;
    aic:contractDoc "A content-addressed unit of ingested evidence, carrying provenance, access-control, and redaction metadata for downstream research and grounding." ;
    aic:hasField bap:evidence_envelope_evidence_id_f ,
                 bap:evidence_envelope_tenant_id_f ,
                 bap:evidence_envelope_source_uri_f ,
                 bap:evidence_envelope_source_kind_f ,
                 bap:evidence_envelope_content_hash_f ,
                 bap:evidence_envelope_mime_type_f ,
                 bap:evidence_envelope_modality_f ,
                 bap:evidence_envelope_observed_at_f ,
                 bap:evidence_envelope_retrieved_at_f ,
                 bap:evidence_envelope_acl_labels_f ,
                 bap:evidence_envelope_canonical_entity_ids_f ,
                 bap:evidence_envelope_redaction_class_f ,
                 bap:evidence_envelope_schema_version_f .

bap:evidence_envelope_evidence_id_f a aic:Field ;
    aic:fieldName "evidence_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique identifier for this evidence envelope." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

bap:evidence_envelope_tenant_id_f a aic:Field ;
    aic:fieldName "tenant_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Owning tenant/organization identifier." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 2 .

bap:evidence_envelope_source_uri_f a aic:Field ;
    aic:fieldName "source_uri" ;
    aic:fieldType "string" ;
    aic:fieldDoc "URI the evidence was retrieved from." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 3 .

bap:evidence_envelope_source_kind_f a aic:Field ;
    aic:fieldName "source_kind" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Kind of source (e.g. web, document, api, sensor)." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 4 .

bap:evidence_envelope_content_hash_f a aic:Field ;
    aic:fieldName "content_hash" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Content-addressed hash of the evidence payload." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 5 .

bap:evidence_envelope_mime_type_f a aic:Field ;
    aic:fieldName "mime_type" ;
    aic:fieldType "string" ;
    aic:fieldDoc "MIME type of the underlying content." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 6 .

bap:evidence_envelope_modality_f a aic:Field ;
    aic:fieldName "modality" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Modality of the evidence (e.g. text, image, audio, video, structured)." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 7 .

bap:evidence_envelope_observed_at_f a aic:Field ;
    aic:fieldName "observed_at" ;
    aic:fieldType "datetime" ;
    aic:fieldDoc "Timestamp the underlying event/content was observed." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 8 .

bap:evidence_envelope_retrieved_at_f a aic:Field ;
    aic:fieldName "retrieved_at" ;
    aic:fieldType "datetime" ;
    aic:fieldDoc "Timestamp this envelope was retrieved/ingested." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 9 .

bap:evidence_envelope_acl_labels_f a aic:Field ;
    aic:fieldName "acl_labels" ;
    aic:fieldType "list_string" ;
    aic:fieldDoc "Access-control labels gating who may read this evidence." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 10 .

bap:evidence_envelope_canonical_entity_ids_f a aic:Field ;
    aic:fieldName "canonical_entity_ids" ;
    aic:fieldType "list_string" ;
    aic:fieldDoc "Canonical entity identifiers this evidence resolves to." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 11 .

bap:evidence_envelope_redaction_class_f a aic:Field ;
    aic:fieldName "redaction_class" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Redaction/sensitivity classification applied to this evidence." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 12 .

bap:evidence_envelope_schema_version_f a aic:Field ;
    aic:fieldName "schema_version" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Schema version this envelope conforms to." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 13 .

# ---------------------------------------------------------------------------
# 2. research_task
# ---------------------------------------------------------------------------

bap:research_task_ct a aic:ContractType ;
    aic:contractName "research_task" ;
    aic:contractDoc "A bounded research request issued by a principal, scoping freshness, privacy, and resource limits for the work it authorizes." ;
    aic:hasField bap:research_task_task_id_f ,
                 bap:research_task_principal_id_f ,
                 bap:research_task_query_f ,
                 bap:research_task_freshness_requirement_f ,
                 bap:research_task_privacy_class_f ,
                 bap:research_task_max_tokens_f ,
                 bap:research_task_max_tool_calls_f ,
                 bap:research_task_output_contract_f ,
                 bap:research_task_policy_version_f ,
                 bap:research_task_correlation_id_f .

bap:research_task_task_id_f a aic:Field ;
    aic:fieldName "task_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique identifier for this research task." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

bap:research_task_principal_id_f a aic:Field ;
    aic:fieldName "principal_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the principal that issued this task." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 2 .

bap:research_task_query_f a aic:Field ;
    aic:fieldName "query" ;
    aic:fieldType "string" ;
    aic:fieldDoc "The research query/prompt driving this task." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 3 .

bap:research_task_freshness_requirement_f a aic:Field ;
    aic:fieldName "freshness_requirement" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Required recency of evidence used to answer the query." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 4 .

bap:research_task_privacy_class_f a aic:Field ;
    aic:fieldName "privacy_class" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Privacy classification bounding what evidence/tools may be used." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 5 .

bap:research_task_max_tokens_f a aic:Field ;
    aic:fieldName "max_tokens" ;
    aic:fieldType "integer" ;
    aic:fieldDoc "Maximum tokens the task's model calls may consume." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 6 .

bap:research_task_max_tool_calls_f a aic:Field ;
    aic:fieldName "max_tool_calls" ;
    aic:fieldType "integer" ;
    aic:fieldDoc "Maximum number of tool invocations permitted for this task." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 7 .

bap:research_task_output_contract_f a aic:Field ;
    aic:fieldName "output_contract" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the output contract the answer must satisfy." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 8 .

bap:research_task_policy_version_f a aic:Field ;
    aic:fieldName "policy_version" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Version of the governing policy this task was admitted under." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 9 .

bap:research_task_correlation_id_f a aic:Field ;
    aic:fieldName "correlation_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Correlation identifier linking this task to related records." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 10 .

# ---------------------------------------------------------------------------
# 3. candidate_claim
# ---------------------------------------------------------------------------

bap:candidate_claim_ct a aic:ContractType ;
    aic:contractName "candidate_claim" ;
    aic:contractDoc "A candidate factual claim produced by a research task, linked to the evidence that supports or contradicts it." ;
    aic:hasField bap:candidate_claim_claim_id_f ,
                 bap:candidate_claim_task_id_f ,
                 bap:candidate_claim_statement_f ,
                 bap:candidate_claim_support_evidence_ids_f ,
                 bap:candidate_claim_contradict_evidence_ids_f ,
                 bap:candidate_claim_confidence_f ,
                 bap:candidate_claim_semantic_status_f .

bap:candidate_claim_claim_id_f a aic:Field ;
    aic:fieldName "claim_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique identifier for this candidate claim." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

bap:candidate_claim_task_id_f a aic:Field ;
    aic:fieldName "task_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the research task that produced this claim." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 2 .

bap:candidate_claim_statement_f a aic:Field ;
    aic:fieldName "statement" ;
    aic:fieldType "string" ;
    aic:fieldDoc "The natural-language statement of the claim." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 3 .

bap:candidate_claim_support_evidence_ids_f a aic:Field ;
    aic:fieldName "support_evidence_ids" ;
    aic:fieldType "list_string" ;
    aic:fieldDoc "Evidence identifiers cited as supporting this claim." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 4 .

bap:candidate_claim_contradict_evidence_ids_f a aic:Field ;
    aic:fieldName "contradict_evidence_ids" ;
    aic:fieldType "list_string" ;
    aic:fieldDoc "Evidence identifiers cited as contradicting this claim." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 5 .

bap:candidate_claim_confidence_f a aic:Field ;
    aic:fieldName "confidence" ;
    aic:fieldType "float" ;
    aic:fieldDoc "Model-estimated confidence in the claim, in the range [0,1]." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 6 .

bap:candidate_claim_semantic_status_f a aic:Field ;
    aic:fieldName "semantic_status" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Closed-vocabulary semantic status of the claim (e.g. supported, contradicted, unverified)." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 7 .

# ---------------------------------------------------------------------------
# 4. tool_intent
#
# NOTE: this contract type carries NO execution-authority field of any
# kind. Authority/admission semantics belong exclusively to the concurrent
# session's beam4pm-post-llm-runtime-pack (rt: vocabulary). This record is
# inert descriptive data about a proposed call, nothing more.
# ---------------------------------------------------------------------------

bap:tool_intent_ct a aic:ContractType ;
    aic:contractName "tool_intent" ;
    aic:contractDoc "A proposed tool invocation awaiting admission. Carries no execution authority of any kind -- authority and admission are the exclusive responsibility of the concurrent beam4pm-post-llm-runtime-pack's rt: vocabulary; this type is inert data describing what a caller would like to do." ;
    aic:hasField bap:tool_intent_intent_id_f ,
                 bap:tool_intent_task_id_f ,
                 bap:tool_intent_tool_id_f ,
                 bap:tool_intent_tool_version_f ,
                 bap:tool_intent_canonical_args_hash_f ,
                 bap:tool_intent_side_effect_class_f ,
                 bap:tool_intent_required_capability_f ,
                 bap:tool_intent_dry_run_f ,
                 bap:tool_intent_idempotency_key_f ,
                 bap:tool_intent_status_f .

bap:tool_intent_intent_id_f a aic:Field ;
    aic:fieldName "intent_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique identifier for this tool intent." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

bap:tool_intent_task_id_f a aic:Field ;
    aic:fieldName "task_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the research task this intent was proposed for." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 2 .

bap:tool_intent_tool_id_f a aic:Field ;
    aic:fieldName "tool_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the tool this intent targets." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 3 .

bap:tool_intent_tool_version_f a aic:Field ;
    aic:fieldName "tool_version" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Version of the targeted tool." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 4 .

bap:tool_intent_canonical_args_hash_f a aic:Field ;
    aic:fieldName "canonical_args_hash" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Content hash of the canonicalized tool arguments." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 5 .

bap:tool_intent_side_effect_class_f a aic:Field ;
    aic:fieldName "side_effect_class" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Declared side-effect class of the intended call (e.g. read, write, external)." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 6 .

bap:tool_intent_required_capability_f a aic:Field ;
    aic:fieldName "required_capability" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Capability label this intent would require if authorized. Descriptive only -- confers no authority itself; see the scope note on aic:tool_intent above." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 7 .

bap:tool_intent_dry_run_f a aic:Field ;
    aic:fieldName "dry_run" ;
    aic:fieldType "boolean" ;
    aic:fieldDoc "Whether this intent is a dry-run/simulation rather than a live proposal." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 8 .

bap:tool_intent_idempotency_key_f a aic:Field ;
    aic:fieldName "idempotency_key" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Idempotency key for de-duplicating repeated proposals of this intent." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 9 .

bap:tool_intent_status_f a aic:Field ;
    aic:fieldName "status" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Lifecycle status of this intent record (e.g. proposed, withdrawn, superseded)." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 10 .

# ---------------------------------------------------------------------------
# 5. admission_decision
# ---------------------------------------------------------------------------

bap:admission_decision_ct a aic:ContractType ;
    aic:contractName "admission_decision" ;
    aic:contractDoc "An independently adjudicated verdict on a subject (e.g. a tool_intent), carrying a typed reason and the policy identity it was decided under." ;
    aic:hasField bap:admission_decision_decision_id_f ,
                 bap:admission_decision_subject_id_f ,
                 bap:admission_decision_principal_id_f ,
                 bap:admission_decision_verdict_f ,
                 bap:admission_decision_typed_reason_f ,
                 bap:admission_decision_policy_id_f ,
                 bap:admission_decision_policy_version_f ,
                 bap:admission_decision_decided_at_f .

bap:admission_decision_decision_id_f a aic:Field ;
    aic:fieldName "decision_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique identifier for this admission decision." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

bap:admission_decision_subject_id_f a aic:Field ;
    aic:fieldName "subject_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the subject (e.g. a tool_intent or candidate_claim) being decided on." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 2 .

bap:admission_decision_principal_id_f a aic:Field ;
    aic:fieldName "principal_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the principal the decision was made on behalf of." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 3 .

bap:admission_decision_verdict_f a aic:Field ;
    aic:fieldName "verdict" ;
    aic:fieldType "string" ;
    aic:fieldDoc "The decision verdict (e.g. admit, refuse)." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 4 .

bap:admission_decision_typed_reason_f a aic:Field ;
    aic:fieldName "typed_reason" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Typed reason code explaining the verdict." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 5 .

bap:admission_decision_policy_id_f a aic:Field ;
    aic:fieldName "policy_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the policy evaluated to reach this verdict." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 6 .

bap:admission_decision_policy_version_f a aic:Field ;
    aic:fieldName "policy_version" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Version of the policy evaluated to reach this verdict." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 7 .

bap:admission_decision_decided_at_f a aic:Field ;
    aic:fieldName "decided_at" ;
    aic:fieldType "datetime" ;
    aic:fieldDoc "Timestamp the decision was made." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 8 .

# ---------------------------------------------------------------------------
# 6. model_call_receipt
# ---------------------------------------------------------------------------

bap:model_call_receipt_ct a aic:ContractType ;
    aic:contractName "model_call_receipt" ;
    aic:contractDoc "Deterministic evidence binding a single model-gateway call's request and response identities, for replay and audit." ;
    aic:hasField bap:model_call_receipt_call_id_f ,
                 bap:model_call_receipt_provider_profile_f ,
                 bap:model_call_receipt_model_id_or_snapshot_f ,
                 bap:model_call_receipt_request_hash_f ,
                 bap:model_call_receipt_response_hash_f ,
                 bap:model_call_receipt_prompt_template_id_f ,
                 bap:model_call_receipt_prompt_template_version_f ,
                 bap:model_call_receipt_latency_ms_f ,
                 bap:model_call_receipt_trace_id_f .

bap:model_call_receipt_call_id_f a aic:Field ;
    aic:fieldName "call_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique identifier for this model call receipt." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

bap:model_call_receipt_provider_profile_f a aic:Field ;
    aic:fieldName "provider_profile" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the model provider/gateway profile used." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 2 .

bap:model_call_receipt_model_id_or_snapshot_f a aic:Field ;
    aic:fieldName "model_id_or_snapshot" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Model identifier or pinned snapshot used for this call." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 3 .

bap:model_call_receipt_request_hash_f a aic:Field ;
    aic:fieldName "request_hash" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Content hash of the canonicalized request." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 4 .

bap:model_call_receipt_response_hash_f a aic:Field ;
    aic:fieldName "response_hash" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Content hash of the canonicalized response." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 5 .

bap:model_call_receipt_prompt_template_id_f a aic:Field ;
    aic:fieldName "prompt_template_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the prompt template used to construct the request." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 6 .

bap:model_call_receipt_prompt_template_version_f a aic:Field ;
    aic:fieldName "prompt_template_version" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Version of the prompt template used to construct the request." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 7 .

bap:model_call_receipt_latency_ms_f a aic:Field ;
    aic:fieldName "latency_ms" ;
    aic:fieldType "integer" ;
    aic:fieldDoc "Observed end-to-end latency of the call, in milliseconds." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 8 .

bap:model_call_receipt_trace_id_f a aic:Field ;
    aic:fieldName "trace_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Distributed trace identifier correlating this call with other records." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 9 .

# ---------------------------------------------------------------------------
# 7. evidence_hit
# ---------------------------------------------------------------------------

bap:evidence_hit_ct a aic:ContractType ;
    aic:contractName "evidence_hit" ;
    aic:contractDoc "One scored retrieval result linking a query to an evidence_envelope." ;
    aic:hasField bap:evidence_hit_hit_id_f ,
                 bap:evidence_hit_query_id_f ,
                 bap:evidence_hit_evidence_id_f ,
                 bap:evidence_hit_score_f ,
                 bap:evidence_hit_retrieval_method_f ,
                 bap:evidence_hit_rank_f .

bap:evidence_hit_hit_id_f a aic:Field ;
    aic:fieldName "hit_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique identifier for this retrieval hit." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

bap:evidence_hit_query_id_f a aic:Field ;
    aic:fieldName "query_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the query that produced this hit." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 2 .

bap:evidence_hit_evidence_id_f a aic:Field ;
    aic:fieldName "evidence_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the evidence_envelope this hit resolves to." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 3 .

bap:evidence_hit_score_f a aic:Field ;
    aic:fieldName "score" ;
    aic:fieldType "float" ;
    aic:fieldDoc "Relevance score assigned to this hit by the retrieval method." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 4 .

bap:evidence_hit_retrieval_method_f a aic:Field ;
    aic:fieldName "retrieval_method" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Identifier of the retrieval method that produced this hit (e.g. bm25, dense, hybrid)." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 5 .

bap:evidence_hit_rank_f a aic:Field ;
    aic:fieldName "rank" ;
    aic:fieldType "integer" ;
    aic:fieldDoc "Rank position of this hit within its query's result set." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 6 .

# =============================================================================
# BeamPM.ProcessGovernor instance data (multi-step process governance,
# delegates entirely to the existing bpma:AdmittedActuation graph above)
# =============================================================================
# fragment never declares its own bpma:AdmittedActuation individuals.

@prefix bpmg: <https://ggen.dev/ontology/beam4pm-process-governor#> .
@prefix bpma: <https://ggen.dev/ontology/beam4pm-actuation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# -- Vocabulary (two classes, five properties; no admission/execution/receipt
#    concepts duplicated from bpma:/BeamPM.Actuation) -------------------------

bpmg:ProcessContract a rdfs:Class ;
    rdfs:comment "A named, ordered sequence of admitted actuations forming one governed multi-step process. Confers zero actuation authority of its own: every transition still passes through BeamPM.Actuation's real admit/execute/receipt boundary one layer down. Distinct from bpma:AdmittedActuation (a single admitted actuation) the way a plan is distinct from one of its steps." .

bpmg:ProcessTransition a rdfs:Class ;
    rdfs:comment "One step of a bpmg:ProcessContract: an exact from-state/to-state pair mapped to exactly one already-admitted bpma:AdmittedActuation by name (bpmg:actuationName). Carries no admission, execution, or receipt logic of its own -- BeamPM.ProcessGovernor.apply_transition/3 delegates the actual admit/execute/receipt work to BeamPM.Actuation.run/2 for the named actuation." .

bpmg:processId a rdf:Property ;
    rdfs:domain bpmg:ProcessContract ;
    rdfs:range xsd:string ;
    rdfs:comment "Stable process identifier, unique across the merged graph." .

bpmg:initialState a rdf:Property ;
    rdfs:domain bpmg:ProcessContract ;
    rdfs:range xsd:string ;
    rdfs:comment "The state a fresh BeamPM.ProcessGovernor.initial_snapshot/2 starts at." .

bpmg:hasTransition a rdf:Property ;
    rdfs:domain bpmg:ProcessContract ;
    rdfs:range bpmg:ProcessTransition .

bpmg:ordinal a rdf:Property ;
    rdfs:domain bpmg:ProcessTransition ;
    rdfs:range xsd:integer ;
    rdfs:comment "1-based position of this transition within its contract's sequence." .

bpmg:fromState a rdf:Property ;
    rdfs:domain bpmg:ProcessTransition ;
    rdfs:range xsd:string ;
    rdfs:comment "Exact-state-hash precondition: apply_transition/3 refuses unless the snapshot presented was produced at exactly this state." .

bpmg:toState a rdf:Property ;
    rdfs:domain bpmg:ProcessTransition ;
    rdfs:range xsd:string ;
    rdfs:comment "The state the snapshot advances to once the delegated BeamPM.Actuation.run/2 call succeeds." .

bpmg:actuationName a rdf:Property ;
    rdfs:domain bpmg:ProcessTransition ;
    rdfs:range xsd:string ;
    rdfs:comment "MUST equal a bpma:actionName of some bpma:AdmittedActuation individual already admitted in this graph. This vocabulary never defines its own admitted-action names or gym ops -- BeamPM.Actuation.admitted_actuations/0 is the single source of truth apply_transition/3 consults." .

# -- Instance data (consumer-admitted) ---------------------------------------
#
# A 2-step governed process over the toy-counter gym, reusing the two
# bpma:AdmittedActuation individuals beam4pm already admits at
# ontology.ttl:915-922 (bpma:increment_counter_aa, action_name
# "increment_counter", requires "counter_ready"; bpma:observe_counter_aa,
# action_name "observe_counter", no required facts). No new bpma:
# individuals are declared here.

bpmg:toy_counter_governed a bpmg:ProcessContract ;
    bpmg:processId "toy_counter_governed" ;
    bpmg:initialState "reset" ;
    bpmg:hasTransition bpmg:toy_counter_t1, bpmg:toy_counter_t2 .

bpmg:toy_counter_t1 a bpmg:ProcessTransition ;
    bpmg:ordinal 1 ;
    bpmg:fromState "reset" ;
    bpmg:toState "incremented_once" ;
    bpmg:actuationName "increment_counter" .

bpmg:toy_counter_t2 a bpmg:ProcessTransition ;
    bpmg:ordinal 2 ;
    bpmg:fromState "incremented_once" ;
    bpmg:toState "observed" ;
    bpmg:actuationName "observe_counter" .

# =============================================================================
# EX3 -- ex4pm semantic-lineage alignment (deliberate, documentation-grade)
# =============================================================================
#
# beam4pm is being reconstituted from ex4pm's real, currently-deployed-in-
# production foundational calculus -- a live 2-replica Deployment on a real
# local Kubernetes cluster (kind-ex4pm context, Postgres-backed, 11 real
# rollout revisions, verified via real kubectl on 2026-08-29) -- rather than
# standing as an independently-invented vocabulary. ex4pm's own README states
# it is "derived from the semantic laws of wasm4pm rather than from its
# directory structure"; this section applies the same discipline to beam4pm,
# one level down the lineage.
#
# This is a beam4pm-side PROJECT INSTANCE/VOCABULARY-ALIGNMENT fragment, not a
# ggen-marketplace pack change: it declares no new bpm:RecordType or bpm:Field
# individuals and adds/queries no vocabulary the beam4pm-process-model-pack
# gates (gates/010_required.rq, gates/020_field_type_enum.rq) inspect, so it
# is inert with respect to gates M0/M1 standing -- confirmed by reading both
# gate queries in full before writing this fragment (both scope strictly to
# `?subject a bpm:RecordType` / `?subject a bpm:Field`).
#
# Sources read in full for this alignment (both are small; read completely,
# not skimmed):
#   - ~/ex4pm/apps/ex4pm_contracts/priv/ontology/ex4pm.ttl (37 lines: the
#     PROV-aligned Observation/EventLog/Event/Object/ProcessModel/Engine/
#     Capability/Intent/Authority/Actuation/Receipt/Refusal calculus, plus
#     the UNKNOWN/PARTIAL_ALIVE/ALIVE/BLOCKED/BUILD_BROKEN/UNSUPPORTED
#     standing vocabulary this whole ecosystem already uses)
#   - ~/ex4pm/apps/ex4pm_contracts/priv/shacl/ex4pm-shapes.ttl (SHACL shapes
#     for ex4pm:Event / ex4pm:ProcessModel / ex4pm:Receipt)
#
# The ex4pm: prefix below is genuinely new to this file -- grep confirmed zero
# prior "ex4pm:" occurrences anywhere in beam4pm's own ontology.ttl before
# this section was appended.
@prefix ex4pm: <https://chatman.ai/ex4pm#> .
@prefix b4a:   <https://ggen.dev/beam4pm/ex4pm-alignment#> .

# -----------------------------------------------------------------------
# 1. bpma:AdmittedActuation -- ex4pm:Authority, not Capability, not Actuation
# -----------------------------------------------------------------------
#
# ex4pm.ttl offers three superficially plausible targets. All three real
# class definitions were read before picking one; two are rejected below by
# name so the choice is falsifiable, not just asserted.
#
#   ex4pm:Capability a rdfs:Class .                          (no subClassOf)
#   -- REJECTED. Its only real instances declared in ex4pm.ttl (lines 32-37
#   there) are the six standing values: ex4pm:UNKNOWN, ex4pm:PARTIAL_ALIVE,
#   ex4pm:ALIVE, ex4pm:BLOCKED, ex4pm:BUILD_BROKEN, ex4pm:UNSUPPORTED. By the
#   ontology's own evidence ex4pm:Capability is the class of STANDING STATES,
#   not of admitted-action definitions. Aligning bpma:AdmittedActuation here
#   would force-fit an action-admission record into an enum-of-statuses class
#   it does not belong to.
#
#   ex4pm:Actuation a rdfs:Class ; rdfs:subClassOf prov:Activity .
#   -- REJECTED. This is the EXECUTED activity (the real DO event) in ex4pm's
#   PROV-aligned calculus. beam4pm's own comment at ontology.ttl:911 ("beam4pm
#   BRCE actuation admission graph (SELECT layer, gate PI7/PI8)") is explicit
#   that bpma:AdmittedActuation lives in the SELECT layer: a static,
#   admission-time record (action_name, gym_op, required facts), never the
#   executed occurrence. The thing beam4pm actually executes
#   (BeamPM.Actuation.run/2, a real side-effecting call) is the true
#   structural analogue of ex4pm:Actuation -- not this admission record.
#
#   ex4pm:Authority a rdfs:Class ; rdfs:subClassOf prov:Entity .
#   -- ACCEPTED. ex4pm:requiresAuthority (rdfs:range ex4pm:Authority)
#   expresses "this activity requires this entity's permission to proceed" --
#   exactly the role bpma:AdmittedActuation plays for beam4pm: a pre-admitted
#   entity recording that one specific named action IS authorized (with which
#   gym_op, under which required facts) before BeamPM.Actuation.run/2 will
#   ever execute it. An Authority (prov:Entity) that a real Actuation
#   (prov:Activity) requires is structurally identical to an
#   AdmittedActuation that a real actuation run consults before executing.
# bpma:AdmittedActuation is used throughout this file only as an rdf:type
# value (`bpma:increment_counter_aa a bpma:AdmittedActuation`, ontology.ttl
# lines 915-922) and was never itself explicitly declared `a rdfs:Class`
# elsewhere in this file. Declaring it here matches this file's own
# convention for every other named class (bpm:RecordType, bpm:Field,
# bpmg:ProcessContract, bpmg:ProcessTransition all carry an explicit
# `a rdfs:Class`) and is required for the rdfs:subClassOf triple below to be
# a class-to-class statement rather than leaving bpma:AdmittedActuation's
# class-hood merely implicit.
bpma:AdmittedActuation a rdfs:Class ;
    rdfs:subClassOf ex4pm:Authority .

# -----------------------------------------------------------------------
# 2. ocel_event -- vocabulary-level rdfs:seeAlso, not a false subClassOf
# -----------------------------------------------------------------------
#
# bpm:RecordType (beam4pm-process-model-pack/ontology.ttl:13-15) is a
# META-CLASS describing record SHAPES ("One admitted BEAM record/struct type
# projected into generated code"). Its instances (bpm:ocel_event_rt,
# bpm:petri_place_rt, ... 31 total in beam4pm's ontology.ttl) are themselves
# individuals, not classes: `bpm:ocel_event_rt a bpm:RecordType`, never
# `bpm:ocel_event_rt a rdfs:Class`. Two candidate alignments were considered
# and rejected before choosing the one below:
#
#   - `bpm:RecordType rdfs:subClassOf ex4pm:Event` -- WRONG. This would claim
#     every one of the 31 admitted record shapes (petri_place, dfg_edge,
#     alignment_move, k8s_object_ref, service_span, ...) is an ex4pm:Event,
#     which is false for 30 of the 31.
#   - `bpm:ocel_event_rt rdfs:subClassOf ex4pm:Event` -- WRONG. RDFS
#     subClassOf relates two classes; bpm:ocel_event_rt is an individual (a
#     record-shape descriptor), not a class. RDF does not mechanically forbid
#     the triple, but it would be a category error identical in kind to
#     saying an instance of Dog "is a subclass of" Animal instead of "is a"
#     Animal.
#
# The genuine correspondence sits one level down: real runtime values SHAPED
# like bpm:ocel_event_rt (an OCEL 2.0 event: event_id / event_type /
# event_time / attributes) are semantically ex4pm:Event instances
# (ex4pm:Event rdfs:subClassOf ex4pm:Observation in ex4pm.ttl). This is
# reinforced field-by-field: bpm:ocel_event_event_type_f and
# bpm:ocel_event_event_time_f (both domain bpm:ocel_event_rt's field set)
# correspond to ex4pm:activity and ex4pm:timestamp (both rdfs:domain
# ex4pm:Event in ex4pm.ttl) -- same two facts (an activity name, a time), same
# governing class, different vocabularies. rdfs:seeAlso -- a real RDFS
# property with no domain/range restriction, meant exactly for "more
# information about this resource lives here" -- states that correspondence
# honestly without asserting a false class hierarchy:
bpm:ocel_event_rt rdfs:seeAlso ex4pm:Event, ex4pm:Observation .

# -----------------------------------------------------------------------
# 3. Standing vocabulary -- confirmed string-identical, cited not modeled
# -----------------------------------------------------------------------
#
# beam4pm has no RDF-level standing individuals of its own anywhere in this
# file or the vendored packs -- UNKNOWN / PARTIAL_ALIVE / ALIVE / BLOCKED /
# BUILD_BROKEN / UNSUPPORTED appear only as plain JSON/Markdown string
# literals (e.g. receipts/2026-08-29-gate-closure-m0-m6.json's
# gate_evidence.*.standing fields; docs/jira/v26.8.29/16-gate-closure-m0-m6.md's
# "GATE M0 ... ALIVE" headings). Verified 2026-08-29 by grepping every one of
# the six exact double-quoted strings across beam4pm's own receipts/**,
# docs/**, and lib/**: all six are present, and all six match ex4pm.ttl's six
# ex4pm:Capability individuals (lines 32-37 there) character-for-character.
# No discrepancy was found -- there is nothing to force-align, only shared
# lineage to cite:
b4a:standingVocabulary
    rdfs:comment "beam4pm's own STANDING vocabulary -- UNKNOWN, PARTIAL_ALIVE, ALIVE, BLOCKED, BUILD_BROKEN, UNSUPPORTED -- used as plain string literals throughout receipts/*.json and docs/jira/**/*.md (e.g. receipts/2026-08-29-gate-closure-m0-m6.json, docs/jira/v26.8.29/16-gate-closure-m0-m6.md) is confirmed STRING-IDENTICAL, character-for-character, to ex4pm's six real ex4pm:Capability individuals (ex4pm.ttl lines 32-37). beam4pm never independently invented this vocabulary and defines no separate RDF-level standing class of its own; it deliberately reuses ex4pm's, cited here as the single shared source of truth for this enum rather than re-derived or restated elsewhere." ;
    rdfs:seeAlso ex4pm:UNKNOWN, ex4pm:PARTIAL_ALIVE, ex4pm:ALIVE, ex4pm:BLOCKED, ex4pm:BUILD_BROKEN, ex4pm:UNSUPPORTED .

