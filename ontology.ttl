    bpm:recordName "path_schema_query" ;
    bpm:recordDoc "A discovery query bounding source/target types and maximum schema length." ;
    bpm:hasField bpm:path_schema_query_source_type_f , bpm:path_schema_query_target_type_f , bpm:path_schema_query_max_length_f .

bpm:path_schema_query_source_type_f a bpm:Field ;
    bpm:fieldName "source_type" ;
