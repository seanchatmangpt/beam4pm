bap:engine_rust4pm_op_align_variants a bpm:EngineOp ;
    bpm:opEngine bap:engine_rust4pm ; bpm:opName "align_variants" ; bpm:opOrder 13 ;
    bpm:opDoc "`{\"op\":\"align_variants\",\"log_handle\":l,\"net_handle\":n[,\"options\":...]}` -- per-variant optimal alignments (pm4py-style move pairs, computed engine-side). `options == nil` omits the key (engine default `max_states: 5_000_000`); a map passes verbatim, including any discounted-cost keys the engine refuses as UNSUPPORTED." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_rust4pm_op_align_variants_log_handle a bpm:EngineArg ;
    bpm:argOp bap:engine_rust4pm_op_align_variants ; bpm:argName "log_handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
