# -- ferroplan (native/ferroplan submodule): PDDL planning --------------------

bap:engine_ferroplan a bpm:Engine ;
    bpm:engineName "ferroplan" ;
    bpm:engineModule "Ferroplan" ;
    bpm:engineDoc "The ferroplan PDDL planning engine (`seanchatmangpt/ferroplan`, the native/ferroplan submodule): grounding, search, temporal/PDDL3 solving and session-based replanning all happen inside the wasm module (`crates/ferroplan-wasm/src/wasi_abi.rs` upstream). The session ops mirror the native `ferroplan::Session` surface one-for-one through an integer session handle." ;
    bpm:engineOrdinal 2 ;
    bpm:wasmExportPrefix "fp" ;
    bpm:wasmArtifactPath "native/ferroplan/target/wasm32-wasip1/release/ferroplan_wasm.wasm" ;
    bpm:wasmBuildScript "scripts/ferroplan_wasm_build.sh" ;
    bpm:wasmBuildHint "(after `git submodule update --init --recursive` if native/ferroplan is empty)" ;
    bpm:dispatchSource "native/ferroplan/crates/ferroplan-wasm/src/wasi_abi.rs" ;
    bpm:healthId "ferroplan_wasm" ;
    bpm:handleNoun "session" ;
    bpm:cheapTimeoutMs 30000 ;
    bpm:heavyTimeoutMs 120000 ;
    bpm:errorCollapse bpm:ErrorCollapse_single_key_inspect .

bap:engine_ferroplan_op_plan a bpm:EngineOp ;
    bpm:opEngine bap:engine_ferroplan ; bpm:opName "plan" ; bpm:opOrder 1 ;
    bpm:opDoc "`{\"op\":\"plan\",\"domain\":d,\"problem\":p[,\"mode\":m,\"flags\":f,\"search\":s]}` -- the compatibility solve surface (lenient mode/search parsing, single threaded). `extra` (default `%{}`) is merged into the request. Returns `{:ok, <Solution map>}`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_ferroplan_op_plan_domain a bpm:EngineArg ;
    bpm:argOp bap:engine_ferroplan_op_plan ; bpm:argName "domain" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_string .
bap:engine_ferroplan_op_plan_problem a bpm:EngineArg ;
    bpm:argOp bap:engine_ferroplan_op_plan ; bpm:argName "problem" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_string .
bap:engine_ferroplan_op_plan_extra a bpm:EngineArg ;
