bap:engine_ferroplan_op_fond_policy a bpm:EngineOp ;
    bpm:opEngine bap:engine_ferroplan ; bpm:opName "fond_policy" ; bpm:opOrder 32 ;
    bpm:opDoc "`{\"op\":\"fond_policy\",\"domain\":d,\"problem\":p[,\"limits\":l]}` -- fully observable non-deterministic (FOND) policy synthesis, PlanningType::Fond via solve_planning_type. `problem` is JSON text of a PlanningProblem (not PDDL). Returns `{:ok, <UniversalPlan map>}`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bap:engine_ferroplan_op_fond_policy_domain a bpm:EngineArg ;
    bpm:argOp bap:engine_ferroplan_op_fond_policy ; bpm:argName "domain" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_string .
bap:engine_ferroplan_op_fond_policy_problem a bpm:EngineArg ;
    bpm:argOp bap:engine_ferroplan_op_fond_policy ; bpm:argName "problem" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_string .

# WS1-OBS-001 — repository_default_branch_observation
b4p:repository_default_branch_observation_rt a bpm:RecordType ;
    bpm:recordName "repository_default_branch_observation" ;
    bpm:recordDoc "Observes a repository default branch and its exact head so autonomic state can invalidate on branch drift." ;
    bpm:hasField b4p:repository_default_branch_observation_repository_id_f,
                 b4p:repository_default_branch_observation_default_branch_f,
                 b4p:repository_default_branch_observation_head_sha_f,
                 b4p:repository_default_branch_observation_observed_at_f .

b4p:repository_default_branch_observation_repository_id_f a bpm:Field ;
    bpm:fieldName "repository_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable repository identity observed by the sensor." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:repository_default_branch_observation_default_branch_f a bpm:Field ;
    bpm:fieldName "default_branch" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Observed default branch name." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:repository_default_branch_observation_head_sha_f a bpm:Field ;
    bpm:fieldName "head_sha" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact commit at the observed default-branch head." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

b4p:repository_default_branch_observation_observed_at_f a bpm:Field ;
    bpm:fieldName "observed_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "Timestamp bounding the freshness of this observation." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .


