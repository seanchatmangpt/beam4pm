    aic:fieldOrder 9 .

bap:evidence_envelope_acl_labels_f a aic:Field ;
    aic:fieldName "acl_labels" ;
    aic:fieldType "list_string" ;
    aic:fieldDoc "Access-control labels gating who may read this evidence." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 10 .

bap:evidence_envelope_canonical_entity_ids_f a aic:Field ;
    aic:fieldName "canonical_entity_ids" ;
    aic:fieldType "list_string" ;
    aic:fieldDoc "Canonical entity identifiers this evidence resolves to." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 11 .

bap:evidence_envelope_redaction_class_f a aic:Field ;
    aic:fieldName "redaction_class" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Redaction/sensitivity classification applied to this evidence." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 12 .

bap:evidence_envelope_schema_version_f a aic:Field ;
    aic:fieldName "schema_version" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Schema version this envelope conforms to." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 13 .

