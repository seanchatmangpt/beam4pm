# =============================================================================
# BeamPM.ProcessGovernor instance data (multi-step process governance,
# delegates entirely to the existing bpma:AdmittedActuation graph above)
# =============================================================================
# fragment never declares its own bpma:AdmittedActuation individuals.

@prefix bpmg: <https://ggen.dev/ontology/beam4pm-process-governor#> .
@prefix bpma: <https://ggen.dev/ontology/beam4pm-actuation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# -- Vocabulary (two classes, five properties; no admission/execution/receipt
#    concepts duplicated from bpma:/BeamPM.Actuation) -------------------------

bpmg:ProcessContract a rdfs:Class ;
    rdfs:comment "A named, ordered sequence of admitted actuations forming one governed multi-step process. Confers zero actuation authority of its own: every transition still passes through BeamPM.Actuation's real admit/execute/receipt boundary one layer down. Distinct from bpma:AdmittedActuation (a single admitted actuation) the way a plan is distinct from one of its steps." .

bpmg:ProcessTransition a rdfs:Class ;
    rdfs:comment "One step of a bpmg:ProcessContract: an exact from-state/to-state pair mapped to exactly one already-admitted bpma:AdmittedActuation by name (bpmg:actuationName). Carries no admission, execution, or receipt logic of its own -- BeamPM.ProcessGovernor.apply_transition/3 delegates the actual admit/execute/receipt work to BeamPM.Actuation.run/2 for the named actuation." .

bpmg:processId a rdf:Property ;
    rdfs:domain bpmg:ProcessContract ;
    rdfs:range xsd:string ;
    rdfs:comment "Stable process identifier, unique across the merged graph." .

bpmg:initialState a rdf:Property ;
    rdfs:domain bpmg:ProcessContract ;
    rdfs:range xsd:string ;
    rdfs:comment "The state a fresh BeamPM.ProcessGovernor.initial_snapshot/2 starts at." .

bpmg:hasTransition a rdf:Property ;
    rdfs:domain bpmg:ProcessContract ;
    rdfs:range bpmg:ProcessTransition .

bpmg:ordinal a rdf:Property ;
    rdfs:domain bpmg:ProcessTransition ;
    rdfs:range xsd:integer ;
    rdfs:comment "1-based position of this transition within its contract's sequence." .

bpmg:fromState a rdf:Property ;
    rdfs:domain bpmg:ProcessTransition ;
    rdfs:range xsd:string ;
    rdfs:comment "Exact-state-hash precondition: apply_transition/3 refuses unless the snapshot presented was produced at exactly this state." .

bpmg:toState a rdf:Property ;
    rdfs:domain bpmg:ProcessTransition ;
    rdfs:range xsd:string ;
    rdfs:comment "The state the snapshot advances to once the delegated BeamPM.Actuation.run/2 call succeeds." .

bpmg:actuationName a rdf:Property ;
    rdfs:domain bpmg:ProcessTransition ;
    rdfs:range xsd:string ;
    rdfs:comment "MUST equal a bpma:actionName of some bpma:AdmittedActuation individual already admitted in this graph. This vocabulary never defines its own admitted-action names or gym ops -- BeamPM.Actuation.admitted_actuations/0 is the single source of truth apply_transition/3 consults." .

# -- Instance data (consumer-admitted) ---------------------------------------
#
# A 2-step governed process over the toy-counter gym, reusing the two
# bpma:AdmittedActuation individuals beam4pm already admits at
# ontology.ttl:915-922 (bpma:increment_counter_aa, action_name
# "increment_counter", requires "counter_ready"; bpma:observe_counter_aa,
# action_name "observe_counter", no required facts). No new bpma:
# individuals are declared here.

bpmg:toy_counter_governed a bpmg:ProcessContract ;
    bpmg:processId "toy_counter_governed" ;
    bpmg:initialState "reset" ;
    bpmg:hasTransition bpmg:toy_counter_t1, bpmg:toy_counter_t2 .

bpmg:toy_counter_t1 a bpmg:ProcessTransition ;
    bpmg:ordinal 1 ;
    bpmg:fromState "reset" ;
    bpmg:toState "incremented_once" ;
    bpmg:actuationName "increment_counter" .

bpmg:toy_counter_t2 a bpmg:ProcessTransition ;
    bpmg:ordinal 2 ;
    bpmg:fromState "incremented_once" ;
    bpmg:toState "observed" ;
    bpmg:actuationName "observe_counter" .

# A 2-step governed process over the real k8s-deployment-scaler gym,
# reusing the two bpma:AdmittedActuation individuals already admitted above
# (bpma:k8s_scale_up_aa, action_name "k8s_scale_up"; bpma:k8s_scale_down_aa,
# action_name "k8s_scale_down"). No new bpma: individuals declared here.
# Exercised in continuous-session mode (BeamPM.ProcessGovernor.run/2's
# `continuous: true` opt-in) so the whole 2-transition sequence runs
# against ONE continuously-running Deployment: one reset, then scale_up
# (1->3), then scale_down (3->1), then one close.
bpmg:k8s_scaling_governed a bpmg:ProcessContract ;
    bpmg:processId "k8s_scaling_governed" ;
    bpmg:initialState "reset" ;
    bpmg:hasTransition bpmg:k8s_scaling_t1, bpmg:k8s_scaling_t2 .

bpmg:k8s_scaling_t1 a bpmg:ProcessTransition ;
    bpmg:ordinal 1 ;
    bpmg:fromState "reset" ;
    bpmg:toState "scaled_up" ;
    bpmg:actuationName "k8s_scale_up" .

bpmg:k8s_scaling_t2 a bpmg:ProcessTransition ;
    bpmg:ordinal 2 ;
    bpmg:fromState "scaled_up" ;
    bpmg:toState "scaled_down" ;
    bpmg:actuationName "k8s_scale_down" .

# =============================================================================
# EX3 -- ex4pm semantic-lineage alignment (deliberate, documentation-grade)
# =============================================================================
#
# beam4pm is being reconstituted from ex4pm's real, currently-deployed-in-
# production foundational calculus -- a live 2-replica Deployment on a real
# local Kubernetes cluster (kind-ex4pm context, Postgres-backed, 11 real
# rollout revisions, verified via real kubectl on 2026-08-29) -- rather than
# standing as an independently-invented vocabulary. ex4pm's own README states
# it is "derived from the semantic laws of wasm4pm rather than from its
# directory structure"; this section applies the same discipline to beam4pm,
# one level down the lineage.
#
# This is a beam4pm-side PROJECT INSTANCE/VOCABULARY-ALIGNMENT fragment, not a
# ggen-marketplace pack change: it declares no new bpm:RecordType or bpm:Field
# individuals and adds/queries no vocabulary the beam4pm-process-model-pack
# gates (gates/010_required.rq, gates/020_field_type_enum.rq) inspect, so it
# is inert with respect to gates M0/M1 standing -- confirmed by reading both
# gate queries in full before writing this fragment (both scope strictly to
# `?subject a bpm:RecordType` / `?subject a bpm:Field`).
#
# Sources read in full for this alignment (both are small; read completely,
# not skimmed):
#   - ~/ex4pm/apps/ex4pm_contracts/priv/ontology/ex4pm.ttl (37 lines: the
#     PROV-aligned Observation/EventLog/Event/Object/ProcessModel/Engine/
#     Capability/Intent/Authority/Actuation/Receipt/Refusal calculus, plus
#     the UNKNOWN/PARTIAL_ALIVE/ALIVE/BLOCKED/BUILD_BROKEN/UNSUPPORTED
#     standing vocabulary this whole ecosystem already uses)
#   - ~/ex4pm/apps/ex4pm_contracts/priv/shacl/ex4pm-shapes.ttl (SHACL shapes
#     for ex4pm:Event / ex4pm:ProcessModel / ex4pm:Receipt)
#
# The ex4pm: prefix below is genuinely new to this file -- grep confirmed zero
# prior "ex4pm:" occurrences anywhere in beam4pm's own ontology.ttl before
# this section was appended.
@prefix ex4pm: <https://chatman.ai/ex4pm#> .
@prefix b4a:   <https://ggen.dev/beam4pm/ex4pm-alignment#> .

# -----------------------------------------------------------------------
# 1. bpma:AdmittedActuation -- ex4pm:Authority, not Capability, not Actuation
# -----------------------------------------------------------------------
#
# ex4pm.ttl offers three superficially plausible targets. All three real
# class definitions were read before picking one; two are rejected below by
# name so the choice is falsifiable, not just asserted.
#
#   ex4pm:Capability a rdfs:Class .                          (no subClassOf)
#   -- REJECTED. Its only real instances declared in ex4pm.ttl (lines 32-37
#   there) are the six standing values: ex4pm:UNKNOWN, ex4pm:PARTIAL_ALIVE,
#   ex4pm:ALIVE, ex4pm:BLOCKED, ex4pm:BUILD_BROKEN, ex4pm:UNSUPPORTED. By the
#   ontology's own evidence ex4pm:Capability is the class of STANDING STATES,
#   not of admitted-action definitions. Aligning bpma:AdmittedActuation here
#   would force-fit an action-admission record into an enum-of-statuses class
#   it does not belong to.
#
#   ex4pm:Actuation a rdfs:Class ; rdfs:subClassOf prov:Activity .
#   -- REJECTED. This is the EXECUTED activity (the real DO event) in ex4pm's
#   PROV-aligned calculus. beam4pm's own comment at ontology.ttl:911 ("beam4pm
#   BRCE actuation admission graph (SELECT layer, gate PI7/PI8)") is explicit
#   that bpma:AdmittedActuation lives in the SELECT layer: a static,
#   admission-time record (action_name, gym_op, required facts), never the
#   executed occurrence. The thing beam4pm actually executes
#   (BeamPM.Actuation.run/2, a real side-effecting call) is the true
#   structural analogue of ex4pm:Actuation -- not this admission record.
#
#   ex4pm:Authority a rdfs:Class ; rdfs:subClassOf prov:Entity .
#   -- ACCEPTED. ex4pm:requiresAuthority (rdfs:range ex4pm:Authority)
#   expresses "this activity requires this entity's permission to proceed" --
#   exactly the role bpma:AdmittedActuation plays for beam4pm: a pre-admitted
#   entity recording that one specific named action IS authorized (with which
#   gym_op, under which required facts) before BeamPM.Actuation.run/2 will
#   ever execute it. An Authority (prov:Entity) that a real Actuation
#   (prov:Activity) requires is structurally identical to an
#   AdmittedActuation that a real actuation run consults before executing.
# bpma:AdmittedActuation is used throughout this file only as an rdf:type
# value (`bpma:increment_counter_aa a bpma:AdmittedActuation`, ontology.ttl
# lines 915-922) and was never itself explicitly declared `a rdfs:Class`
# elsewhere in this file. Declaring it here matches this file's own
# convention for every other named class (bpm:RecordType, bpm:Field,
# bpmg:ProcessContract, bpmg:ProcessTransition all carry an explicit
# `a rdfs:Class`) and is required for the rdfs:subClassOf triple below to be
# a class-to-class statement rather than leaving bpma:AdmittedActuation's
# class-hood merely implicit.
bpma:AdmittedActuation a rdfs:Class ;
    rdfs:subClassOf ex4pm:Authority .

# -----------------------------------------------------------------------
# 2. ocel_event -- vocabulary-level rdfs:seeAlso, not a false subClassOf
# -----------------------------------------------------------------------
#
# bpm:RecordType (beam4pm-process-model-pack/ontology.ttl:13-15) is a
# META-CLASS describing record SHAPES ("One admitted BEAM record/struct type
# projected into generated code"). Its instances (bpm:ocel_event_rt,
# bpm:petri_place_rt, ... 31 total in beam4pm's ontology.ttl) are themselves
# individuals, not classes: `bpm:ocel_event_rt a bpm:RecordType`, never
# `bpm:ocel_event_rt a rdfs:Class`. Two candidate alignments were considered
# and rejected before choosing the one below:
#
#   - `bpm:RecordType rdfs:subClassOf ex4pm:Event` -- WRONG. This would claim
#     every one of the 31 admitted record shapes (petri_place, dfg_edge,
#     alignment_move, k8s_object_ref, service_span, ...) is an ex4pm:Event,
#     which is false for 30 of the 31.
#   - `bpm:ocel_event_rt rdfs:subClassOf ex4pm:Event` -- WRONG. RDFS
#     subClassOf relates two classes; bpm:ocel_event_rt is an individual (a
#     record-shape descriptor), not a class. RDF does not mechanically forbid
#     the triple, but it would be a category error identical in kind to
#     saying an instance of Dog "is a subclass of" Animal instead of "is a"
#     Animal.
#
# The genuine correspondence sits one level down: real runtime values SHAPED
# like bpm:ocel_event_rt (an OCEL 2.0 event: event_id / event_type /
# event_time / attributes) are semantically ex4pm:Event instances
# (ex4pm:Event rdfs:subClassOf ex4pm:Observation in ex4pm.ttl). This is
# reinforced field-by-field: bpm:ocel_event_event_type_f and
# bpm:ocel_event_event_time_f (both domain bpm:ocel_event_rt's field set)
# correspond to ex4pm:activity and ex4pm:timestamp (both rdfs:domain
# ex4pm:Event in ex4pm.ttl) -- same two facts (an activity name, a time), same
# governing class, different vocabularies. rdfs:seeAlso -- a real RDFS
# property with no domain/range restriction, meant exactly for "more
# information about this resource lives here" -- states that correspondence
# honestly without asserting a false class hierarchy:
bpm:ocel_event_rt rdfs:seeAlso ex4pm:Event, ex4pm:Observation .

# -----------------------------------------------------------------------
# 3. Standing vocabulary -- confirmed string-identical, cited not modeled
# -----------------------------------------------------------------------
#
# beam4pm has no RDF-level standing individuals of its own anywhere in this
# file or the vendored packs -- UNKNOWN / PARTIAL_ALIVE / ALIVE / BLOCKED /
# BUILD_BROKEN / UNSUPPORTED appear only as plain JSON/Markdown string
# literals (e.g. receipts/2026-08-29-gate-closure-m0-m6.json's
# gate_evidence.*.standing fields; docs/jira/v26.8.29/16-gate-closure-m0-m6.md's
# "GATE M0 ... ALIVE" headings). Verified 2026-08-29 by a one-time manual
# grep of the six exact strings across beam4pm's own receipts/**, docs/**,
# and lib/**; that manual check is now a real, re-runnable script instead
# (`scripts/standing_vocabulary_check.sh`, added 2026-08-30 after an
# adversarial verification pass correctly flagged the manual-grep-only
# claim as the one ALIVE item in that receipt with no re-runnable evidence
# behind it, unlike its siblings). All six are present, and all six match
# ex4pm.ttl's six ex4pm:Capability individuals (lines 32-37 there)
# character-for-character. No discrepancy was found -- there is nothing to
# force-align, only shared
# lineage to cite:
b4a:standingVocabulary
    rdfs:comment "beam4pm's own STANDING vocabulary -- UNKNOWN, PARTIAL_ALIVE, ALIVE, BLOCKED, BUILD_BROKEN, UNSUPPORTED -- used as plain string literals throughout receipts/*.json and docs/jira/**/*.md (e.g. receipts/2026-08-29-gate-closure-m0-m6.json, docs/jira/v26.8.29/16-gate-closure-m0-m6.md) is confirmed STRING-IDENTICAL, character-for-character, to ex4pm's six real ex4pm:Capability individuals (ex4pm.ttl lines 32-37). beam4pm never independently invented this vocabulary and defines no separate RDF-level standing class of its own; it deliberately reuses ex4pm's, cited here as the single shared source of truth for this enum rather than re-derived or restated elsewhere." ;
    rdfs:seeAlso ex4pm:UNKNOWN, ex4pm:PARTIAL_ALIVE, ex4pm:ALIVE, ex4pm:BLOCKED, ex4pm:BUILD_BROKEN, ex4pm:UNSUPPORTED .

# -----------------------------------------------------------------------
# 4. RF2 -- rust4pm function-surface Reactor validation (conformance)
# -----------------------------------------------------------------------
#
# Real admission fact for RF2 (process_mining::conformance::case_centric):
# names the exact oracle binary, wire op, and dataset BeamPM.Rf2Conformance's
# Reactor pipeline is manufactured against. Not used for numeric gating (the
# fitness/place/transition constants baked into lib/beam4pm_rf2_conformance.ex
# are physical measurements from a real rf2-conformance-oracle run against
# this exact dataset, not RDF-derived) -- this graph documents WHICH oracle/
# dataset pairing is admitted, and is queried for real via
# mix ggen_igniter.sync's real oxigraph engine, proving the render pipeline
# itself (not just its template body) is real. Adapted from the
# rust4pm-Reactor-validation swarm (wf_7cdca56f-f92), independently
# re-verified (clean cargo rebuild, fresh mix test) before integration.
@prefix rf2: <https://ggen.dev/beam4pm/rf2-conformance#> .

rf2:ConformanceStream a rf2:AdmittedOracleStream ;
    rf2:oracleName "rf2-conformance-oracle" ;
    rf2:wireOp "conformance" ;
    rf2:datasetPath "/Users/sac/wasm4pm/fixtures/shared/receipt.xes" ;
    rf2:moduleName "BeamPM.Rf2Conformance" .

# =============================================================================
# beam4pm_pro MP3 (entitlement reconciliation) + MP6 (billing/usage dedup)
# admitted bpm:RecordType instance data
# =============================================================================
#
# Manufactured by vendor/ggen-marketplace/packs/beam4pm-pro-entitlement-pack
# (schema-only, same contract as beam4pm-pro-infra-pack -- the pack ships
# zero individuals of its own; these four facts are this consumer's own
# fragment). bpm:RecordType / bpm:Field and their properties are the SAME
# vocabulary beam4pm-process-model-pack already declares, reused verbatim,
# not redefined. Field names below are exactly what
# beam4pm_entitlement.{erl,ex}.tmpl and beam4pm_billing.{erl,ex}.tmpl require
# to exist (a real, documented constraint -- see those templates' own module
# headers) -- entitlement_event: event_id, entitlement_id, event_type,
# effective_at, payload; entitlement_state: entitlement_id, status,
# last_applied_event_id, updated_at; usage_event: event_id, entitlement_id,
# quantity, metric_name, occurred_at; billing_reconciliation: entitlement_id,
# metric_name, total_quantity, applied_event_ids, period_start, period_end.
#
# STANDING: SELECT-layer facts only. They manufacture types and two
# reconciliation algorithms verified against synthetic events (real
# adversarial verification, 2026-08-30: 9 findings, all CONFIRMED, all fixed
# before this pack's first commit -- see ggen-marketplace commit de03103b6);
# they confer no MP3/MP6 release standing. A record type is not a deployed
# entitlement/billing system; both gates remain BLOCKED on real Partner
# Procurement API access and a seller account.
@prefix b4pe: <http://seanchatmangpt.github.io/packs/beam4pm-pro-entitlement#> .

# ---------------------------------------------------------------------------
# entitlement_event -- one inbound entitlement/order/agreement lifecycle
# notification from the marketplace provider (Google Cloud Commerce Partner
# Procurement API Pub/Sub message shape). Append-only, at-least-once.
# ---------------------------------------------------------------------------
b4pe:entitlement_event_rt a bpm:RecordType ;
    bpm:recordName "entitlement_event" ;
    bpm:recordDoc "One inbound marketplace entitlement/order/agreement lifecycle event, as delivered by the provider's notification topic. Append-only and at-least-once: the same event_id may be delivered any number of times, in any order relative to other events. Modeled on the Google Cloud Commerce Partner Procurement API Pub/Sub notification message, whose payload carries both an eventId and an entitlement id." ;
    bpm:hasField b4pe:entitlement_event_event_id_f ,
                 b4pe:entitlement_event_entitlement_id_f ,
                 b4pe:entitlement_event_event_type_f ,
                 b4pe:entitlement_event_effective_at_f ,
                 b4pe:entitlement_event_payload_f .

b4pe:entitlement_event_event_id_f a bpm:Field ;
    bpm:fieldName "event_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "DEDUP KEY. The provider's own globally unique notification identifier (the eventId field of the Partner Procurement Pub/Sub message). Two deliveries carrying the same event_id are the same event and must fold to the same entitlement_state exactly once. This is provider-assigned, never locally minted -- a locally generated id would make redelivery indistinguishable from a genuine new event." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4pe:entitlement_event_entitlement_id_f a bpm:Field ;
    bpm:fieldName "entitlement_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "The commercial identity this event applies to (Partner Procurement ENTITLEMENT_ID). Reconciliation partitions strictly by this key. Google supports multiple concurrent orders of the same product, so entitlement_id -- not account id and not product id -- is the only admissible partition key." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4pe:entitlement_event_event_type_f a bpm:Field ;
    bpm:fieldName "event_type" ; bpm:fieldType "string" ;
    bpm:fieldDoc "CLOSED SET, exactly the 13 entitlement event types published by Google Cloud Marketplace for integrated SaaS products: ENTITLEMENT_CREATION_REQUESTED | ENTITLEMENT_OFFER_ACCEPTED | ENTITLEMENT_ACTIVE | ENTITLEMENT_PLAN_CHANGE_REQUESTED | ENTITLEMENT_PLAN_CHANGED | ENTITLEMENT_PLAN_CHANGE_CANCELLED | ENTITLEMENT_PENDING_CANCELLATION | ENTITLEMENT_CANCELLATION_REVERTED | ENTITLEMENT_CANCELLED | ENTITLEMENT_CANCELLING | ENTITLEMENT_RENEWED | ENTITLEMENT_OFFER_ENDED | ENTITLEMENT_DELETED. Typed string, deliberately NOT atom: these values arrive verbatim from an external wire and binary_to_atom/2 over untrusted input is an unbounded atom-table growth path on the BEAM. An unrecognized value is a typed refusal, never a silently ignored event." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

b4pe:entitlement_event_effective_at_f a bpm:Field ;
    bpm:fieldName "effective_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 UTC instant at which this event takes commercial effect (provider-assigned, not local receipt time). Primary component of the reconciliation watermark; ties are broken by event_id so that the fold is a total order and therefore order-independent. Local receipt time is deliberately not modeled: it would make the fold non-deterministic under replay." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

b4pe:entitlement_event_payload_f a bpm:Field ;
    bpm:fieldName "payload" ; bpm:fieldType "map" ;
    bpm:fieldDoc "Optional provider-specific extra fields carried verbatim (e.g. account id, product/plan id, offer id, newPlan, newOffer, scheduled start time). Retained for receipt/audit fidelity; the reconciliation fold reads NO field from this map -- everything the fold depends on is promoted to a typed top-level field above." ;
    bpm:fieldRequired "false" ; bpm:fieldOrder 5 .

# ---------------------------------------------------------------------------
# entitlement_state -- the reconciled current state of exactly one
# entitlement, the single-valued result of folding its entitlement_event set.
# ---------------------------------------------------------------------------
b4pe:entitlement_state_rt a bpm:RecordType ;
    bpm:recordName "entitlement_state" ;
    bpm:recordDoc "The reconciled current state of one entitlement, derived purely by folding its entitlement_event set. The fold is idempotent (replaying an already-applied event is a no-op) and commutative in arrival order (an older event arriving after a newer one is a no-op), because an event is applied if and only if its (effective_at, event_id) pair is strictly greater than the state's (updated_at, last_applied_event_id) watermark." ;
    bpm:hasField b4pe:entitlement_state_entitlement_id_f ,
                 b4pe:entitlement_state_status_f ,
                 b4pe:entitlement_state_last_applied_event_id_f ,
                 b4pe:entitlement_state_updated_at_f .

b4pe:entitlement_state_entitlement_id_f a bpm:Field ;
    bpm:fieldName "entitlement_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "The commercial identity this state describes (Partner Procurement ENTITLEMENT_ID). Unique key: at most one entitlement_state exists per entitlement_id." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4pe:entitlement_state_status_f a bpm:Field ;
    bpm:fieldName "status" ; bpm:fieldType "string" ;
    bpm:fieldDoc "CLOSED SET, exactly the 8 values of the Cloud Commerce Partner Procurement API's EntitlementState enum: ENTITLEMENT_STATE_UNSPECIFIED | ENTITLEMENT_ACTIVATION_REQUESTED | ENTITLEMENT_ACTIVE | ENTITLEMENT_PENDING_CANCELLATION | ENTITLEMENT_CANCELLED | ENTITLEMENT_PENDING_PLAN_CHANGE | ENTITLEMENT_PENDING_PLAN_CHANGE_APPROVAL | ENTITLEMENT_SUSPENDED. This is the provider's STATE enum, which is deliberately not the same closed set as entitlement_event.event_type: ENTITLEMENT_SUSPENDED is a reachable state with no corresponding notification event type, and ENTITLEMENT_RENEWED / ENTITLEMENT_OFFER_ENDED / ENTITLEMENT_DELETED are event types with no distinct state. The event_type -> status transition table is therefore an explicit, non-identity mapping, never a string rename." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4pe:entitlement_state_last_applied_event_id_f a bpm:Field ;
    bpm:fieldName "last_applied_event_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "The event_id of the single entitlement_event that produced this state. Second (tiebreak) component of the reconciliation watermark, and the audit link from a commercial state back to the exact provider notification that caused it. Required, never undefined: an entitlement_state may only be constructed by applying a real event, so there is no lawful state without a causing event id." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

b4pe:entitlement_state_updated_at_f a bpm:Field ;
    bpm:fieldName "updated_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "The effective_at of the last applied event -- NOT wall-clock ingestion time. First component of the reconciliation watermark. Defining it as provider effective time (a) makes the state a pure function of the event set, so the same events replayed in any order at any later date rebuild a byte-identical state, and (b) makes the strictly-greater-than admission test well-founded. A wall-clock updated_at would silently admit an out-of-order older event, because it always advances." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

# ---------------------------------------------------------------------------
# usage_event -- one metered consumption event to be billed. At-least-once
# delivery; dedup is a property of the reconciliation fold, not the store.
# ---------------------------------------------------------------------------
b4pe:usage_event_rt a bpm:RecordType ;
    bpm:recordName "usage_event" ;
    bpm:recordDoc "One metered usage/consumption occurrence to be billed against an entitlement. event_id is the idempotency key that is ALSO the operationId reported to the provider's usage API, so local dedup and provider-side dedup are keyed identically and can never disagree." ;
    bpm:hasField b4pe:usage_event_event_id_f ,
                 b4pe:usage_event_entitlement_id_f ,
                 b4pe:usage_event_quantity_f ,
                 b4pe:usage_event_metric_name_f ,
                 b4pe:usage_event_occurred_at_f .

b4pe:usage_event_event_id_f a bpm:Field ;
    bpm:fieldName "event_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "DEDUP KEY. Stable, deterministic, locally minted identifier for this metered occurrence -- and the exact value sent as operationId on the Service Control services.report call, which is the provider's own documented deduplication mechanism. It MUST be derived from the occurrence itself, never from a random UUID or a wall clock: a re-minted id on retry would defeat both local and provider-side dedup and double bill. Counting the same event_id twice in a billing_reconciliation.total_quantity is the exact MP6 failure." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4pe:usage_event_entitlement_id_f a bpm:Field ;
    bpm:fieldName "entitlement_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "The entitlement this usage is billed against (Partner Procurement ENTITLEMENT_ID); resolves to the provider's consumerId at report time. Usage whose entitlement_id has no reconciled entitlement_state is a typed refusal, never silently billed and never silently dropped." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4pe:usage_event_quantity_f a bpm:Field ;
    bpm:fieldName "quantity" ; bpm:fieldType "float" ;
    bpm:fieldDoc "The measured amount for this single occurrence, in the unit implied by metric_name. Non-negative: a correction is a separate, explicitly-typed adjustment, never a negative usage_event, because negative quantities make the dedup-set sum order-sensitive at the boundaries and make a double-counted event cancellable rather than detectable." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

b4pe:usage_event_metric_name_f a bpm:Field ;
    bpm:fieldName "metric_name" ; bpm:fieldType "string" ;
    bpm:fieldDoc "The fully qualified metered dimension this occurrence counts against. Reconciliation partitions by (entitlement_id, metric_name): quantities in different metrics are never summed together." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

b4pe:usage_event_occurred_at_f a bpm:Field ;
    bpm:fieldName "occurred_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 UTC instant the usage actually occurred (not when it was observed, queued, or reported)." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .

# ---------------------------------------------------------------------------
# billing_reconciliation -- the reconciled total for one (entitlement_id,
# metric_name) over one caller-supplied half-open period.
# ---------------------------------------------------------------------------
b4pe:billing_reconciliation_rt a bpm:RecordType ;
    bpm:recordName "billing_reconciliation" ;
    bpm:recordDoc "The reconciled billable total for one (entitlement_id, metric_name) pair over one half-open period [period_start, period_end). INVARIANT: total_quantity is exactly the sum of usage_event.quantity over the distinct event_ids listed in applied_event_ids, summed in that list's ascending order; applied_event_ids is sorted and duplicate-free. Consequently the same usage_event.event_id can never contribute twice, no matter how many times or in what order it appears in the input stream." ;
    bpm:hasField b4pe:billing_reconciliation_entitlement_id_f ,
                 b4pe:billing_reconciliation_metric_name_f ,
                 b4pe:billing_reconciliation_total_quantity_f ,
                 b4pe:billing_reconciliation_applied_event_ids_f ,
                 b4pe:billing_reconciliation_period_start_f ,
                 b4pe:billing_reconciliation_period_end_f .

b4pe:billing_reconciliation_entitlement_id_f a bpm:Field ;
    bpm:fieldName "entitlement_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "The entitlement this total is billed against. First component of the reconciliation partition key." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4pe:billing_reconciliation_metric_name_f a bpm:Field ;
    bpm:fieldName "metric_name" ; bpm:fieldType "string" ;
    bpm:fieldDoc "The metered dimension this total is for. Second component of the reconciliation partition key; totals are never summed across metrics." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4pe:billing_reconciliation_total_quantity_f a bpm:Field ;
    bpm:fieldName "total_quantity" ; bpm:fieldType "float" ;
    bpm:fieldDoc "The billable total: the sum of quantity over the distinct events named in applied_event_ids, accumulated in that list's ascending event_id order. The fixed summation order is load-bearing, not incidental -- float addition is non-associative, so only a canonical order makes the total bit-identical across arrival orders and across replays. Recomputable by any third party from applied_event_ids plus the usage_event store, which is what makes this a receipt rather than a claim." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

b4pe:billing_reconciliation_applied_event_ids_f a bpm:Field ;
    bpm:fieldName "applied_event_ids" ; bpm:fieldType "list_string" ;
    bpm:fieldDoc "The exact deduplicated evidence set behind total_quantity: every usage_event.event_id counted, sorted ascending, with no duplicates. This is the dedup contract made auditable -- |applied_event_ids| is the honest count of billed occurrences, and any event_id appearing at most once here is a mechanically checkable falsifier for MP6 double-billing." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

b4pe:billing_reconciliation_period_start_f a bpm:Field ;
    bpm:fieldName "period_start" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 UTC INCLUSIVE lower bound of the billing period. An event is in-period when period_start <= occurred_at. Caller-supplied to reconcile_billing/4, never derived from the input events themselves -- see period_end's fieldDoc for why." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 5 .

b4pe:billing_reconciliation_period_end_f a bpm:Field ;
    bpm:fieldName "period_end" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 UTC EXCLUSIVE upper bound of the billing period. An event is in-period when occurred_at < period_end. The exclusive bound is what prevents an event landing exactly on a period boundary from being counted by both the closing and the opening period -- a boundary double-bill that per-period dedup alone would not catch. reconcile_billing/4 takes {PeriodStart, PeriodEnd} as an explicit argument and filters events by it before dedup, which is what makes this guarantee real." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 6 .

