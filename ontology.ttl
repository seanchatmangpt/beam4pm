    bpm:recordName "booking_readiness" ;
    bpm:recordDoc "Produces an explicit booking-readiness decision after commercial, legal, security, and procurement evidence converge." ;
    bpm:hasField b4p:booking_readiness_opportunity_id_f ,
                 b4p:booking_readiness_readiness_id_f ,
                 b4p:booking_readiness_decision_f .

b4p:booking_readiness_opportunity_id_f a bpm:Field ;
    bpm:fieldName "opportunity_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required booking readiness input; omission is an executable typed refusal, never an inferred approval." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 1 .

b4p:booking_readiness_readiness_id_f a bpm:Field ;
    bpm:fieldName "readiness_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Required booking readiness input; omission is an executable typed refusal, never an inferred approval." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 2 .

b4p:booking_readiness_decision_f a bpm:Field ;
   bpm:fieldName "decision" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Immutable decision or evidence identity used to verify and replay this bounded commercial admission." ;
    bpm:fieldRequired "true" ; bpm:fieldOrder 3 .

