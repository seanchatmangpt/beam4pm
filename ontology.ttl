# WS4-REV-006 — immutable action pin evidence.
b4pe:action_pin_evidence_rt a bpm:RecordType ;
    bpm:recordName "action_pin_evidence" ;
    bpm:recordDoc "Executable workflow-supply-chain evidence proving a referenced GitHub Action resolves to an immutable commit identity." ;
    bpm:hasField b4pe:action_pin_evidence_id_f,
