

# v26.9.18 — GALL semantic-work lifecycle
# Canonical process-observation vocabulary for the semantic work fabric.
# Public ontology classes/properties carry semantics; these GALL IRIs are
# stable activity identities, not a second execution-authority model.
@prefix gallproc: <https://semantic-a2a.dev/gall/process#> .
@prefix gall: <https://semantic-a2a.dev/gall#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gallproc:SemanticWorkLifecycle
    a skos:ConceptScheme ;
    dcterms:title "GALL Semantic Work Lifecycle" ;
    dcterms:description "Observation vocabulary for checkpoint admission, construction, verification, receipt, repair, and frontier transitions. Observation grants no authority." .

gallproc:checkpointAdmitted a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "checkpoint_admitted" .

gallproc:runCreated a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "run_created" .

gallproc:epochCreated a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "epoch_created" .

gallproc:worktreeProvisioned a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "worktree_provisioned" .

gallproc:leaseClaimed a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "lease_claimed" .

gallproc:toolAdmitted a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "tool_admitted" .

gallproc:candidateCommitted a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "candidate_committed" .

gallproc:leaseClosed a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "lease_closed" .

gallproc:verificationStarted a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "verification_started" .

gallproc:verificationFinished a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "verification_finished" .

gallproc:receiptSealed a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "receipt_sealed" .

gallproc:repairCreated a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "repair_created" .

gallproc:checkpointPromoted a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "checkpoint_promoted" .

gallproc:frontierUnlocked a skos:Concept ;
    skos:inScheme gallproc:SemanticWorkLifecycle ;
    skos:prefLabel "frontier_unlocked" .

# Cross-system object identities are represented as PROV entities/activities.
# A process observation can point at these without implying admission or DO.
gallproc:CheckpointObservation a prov:Entity ;
    dcterms:description "Observed semantic checkpoint identity; observation is not execution." .

gallproc:WorkerExecution a prov:Activity ;
    dcterms:description "Observed bounded worker activity associated with a checkpoint, epoch, lease, candidate, verifier, or receipt identity." .
